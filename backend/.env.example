PORT=5000
NODE_ENV=development

DATABASE_URL=postgresql://postgres:password@localhost:5432/gobuyme

JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

PAYSTACK_SECRET_KEY=sk_test_
PAYSTACK_PUBLIC_KEY=pk_test_

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@gobuyme.shop

CLIENT_URL=http://localhost:8081
ADMIN_URL=http://localhost:5173

DELIVERY_BASE_FEE=1500
DELIVERY_PER_KM_RATE=100
DELIVERY_MAX_FEE=999999

RIDER_NET_CUT=0.85
RIDER_PLATFORM_CUT=0.15

COMMISSION_TIER_1_RATE=0.03
COMMISSION_TIER_2_RATE=0.075

PAYOUT_CRON_SCHEDULE=30 11 * * *

DEFAULT_VENDOR_RADIUS_KM=10

# Geocoding — Nominatim (OpenStreetMap) is primary, MapTiler is the fallback when
# Nominatim is rate-limited or resolves nothing. MapTiler key can be the same account
# used for EXPO_PUBLIC_MAPTILER_KEY. NOMINATIM_BASE_URL points at the public instance by
# default; swap to a self-hosted Nominatim instance in production without code changes.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=GoBuyMe/1.0 (support@gobuyme.shop)
MAPTILER_API_KEY=

# Routing — OSRM. Defaults to the public demo server (fine for development, rate-limited,
# not for production use). Point at a self-hosted OSRM instance in production.
OSRM_BASE_URL=https://router.project-osrm.org

# Only needed to re-run prisma/scripts/apply-pexels-to-seed-*.ts (free key: pexels.com/api)
PEXELS_API_KEY=

# Vendor order escalation — SMS reminders/urgent alerts (Termii, termii.com)
TERMII_API_KEY=
TERMII_SENDER_ID=

# Vendor order escalation — urgent WhatsApp alert (Meta WhatsApp Business Cloud API).
# Requires an approved message template (e.g. "urgent_order_alert") in Meta Business Manager.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Vendor order escalation — browser push for the gobuyme-web vendor dashboard.
# Generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY must also be set as NEXT_PUBLIC_VAPID_PUBLIC_KEY in gobuyme-web's env.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@gobuyme.shop

# ── Error-analysis agent ───────────────────────────────────────────────
# Classifies every incoming ErrorLog (USER_ERROR / SERVER_ERROR / ATTACK /
# SYSTEM_RISK) the moment it's persisted. Fast rules run first; only ambiguous
# errors hit the Claude API. Leave ANTHROPIC_API_KEY unset to run rules-only.
ANTHROPIC_API_KEY=
ERROR_ANALYSIS_LLM_ENABLED=true
ERROR_ANALYSIS_LLM_MODEL=claude-haiku-4-5

# ── Telegram critical-error escalation (shared super-admin alerts chat) ─
# Create a bot via @BotFather, add it to a group every SUPER_ADMIN joins, then
# put the bot token and that group's chat id (a negative number) here. Missing
# values simply disable escalation — analysis still runs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
# Per-fingerprint cooldown (s) between alerts for the "same" recurring error, and
# a hard ceiling on alerts/hour as an incident backstop.
ERROR_ALERT_COOLDOWN_SECONDS=900
ERROR_ALERT_HOURLY_CAP=20
# Used to build the deep link in the alert back to the admin dashboard.
ADMIN_DASHBOARD_URL=http://localhost:3000

# ── Cloudflare WAF — Automated IP blocking for CRITICAL attacks ─────────
# When an attack is classified CRITICAL, the source IP is automatically added
# to a Cloudflare IP list and blocked at the edge. To enable:
# 1. Get API token (cloudflare.com/profile/api-tokens) with permissions:
#    - Account › Lists › Edit
#    - Zone › WAF Rules › Edit
# 2. Get Zone ID from domain overview page
# 3. Create WAF rule: (cf.threat_score >= 50) OR (ip in $gobuyme-attack-blocklist) → Block
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# Optional: if you've already created a custom IP list, set its ID here. Otherwise
# the system will create one automatically on first use.
CLOUDFLARE_IP_BLOCKLIST_ID=
