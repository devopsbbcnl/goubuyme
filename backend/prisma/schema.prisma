enum ErrorCategory {
  USER_ERROR
  SERVER_ERROR
  ATTACK
  SYSTEM_RISK
  UNKNOWN
}

enum ErrorSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model ErrorLog {
  id         String    @id @default(uuid())
  userId     String?
  role       String?
  platform   String
  source     String
  message    String
  stack      String?
  context    Json?
  appVersion String?
  deviceInfo Json?
  url        String?
  method     String?
  resolved   Boolean   @default(false)
  resolvedAt DateTime?
  resolvedBy String?
  createdAt  DateTime  @default(now())

  // Populated asynchronously by the error-analysis agent (errorAnalysis.service.ts)
  // right after the row is created. All nullable — an unanalyzed row is valid.
  category         ErrorCategory?
  severity         ErrorSeverity?
  aiSummary        String?
  aiRecommendation String?
  analyzedBy       String? // "rules" | "llm" | "llm-unavailable"
  analyzedAt       DateTime?
  fingerprint      String? // dedupe key for Telegram escalation throttling
  escalatedAt      DateTime?

  @@index([createdAt])
  @@index([resolved])
  @@index([platform])
  @@index([userId])
  @@index([category])
  @@index([severity])
  @@index([fingerprint])
  @@map("error_logs")
}

/// In-house product analytics stream (no third-party SDK). Client events arrive batched
/// via POST /events; order/payment/delivery events are written server-side by
/// analytics.service.ts. Properties must never carry PII — ids, counts and amounts only.
/// Pruned after ANALYTICS_RETENTION_DAYS by analyticsRetentionJob.
model AppEvent {
  id          String   @id @default(uuid())
  name        String
  /// Derived from the access token server-side, never trusted from the client.
  userId      String?
  /// Random per-install/per-browser id, so pre-login activity can be funnelled too.
  anonymousId String?
  role        String?
  platform    String // MOBILE | WEB | SERVER
  sessionId   String?
  screen      String?
  properties  Json?
  appVersion  String?
  occurredAt  DateTime
  createdAt   DateTime @default(now())

  @@index([name, occurredAt])
  @@index([userId, occurredAt])
  @@index([anonymousId])
  @@index([occurredAt])
  @@map("app_events")
}

