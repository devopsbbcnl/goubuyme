  FAILED
}

enum ProspectStatus {
  NEW
  ADDED
  DISMISSED
}

enum LeadActivityType {
  NOTE
  CALL
  VISIT
  EMAIL
  WHATSAPP
  SMS
  STAGE_CHANGE
  CONVERTED
}

enum TaskStatus {
  OPEN
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
}

/// A prospective vendor or rider being signed up by the ops/sales team.
model Lead {
  id                  String                   @id @default(uuid())
  type                LeadType
  /// Business name for vendors, person's name for riders.
  name                String
  contactName         String?
  phone               String?
  /// Last 10 digits of the phone, used to match leads to accounts that sign up later.
  phoneKey            String?
  email               String?
  whatsapp            String?
  website             String?
  instagram           String?
  facebook            String?
  tiktok              String?
  twitter             String?
  youtube             String?
  /// The person asked us to stop marketing messages. Staff can set it; only the person can clear it.
  marketingOptOut     Boolean                  @default(false)
  optOutAt            DateTime?
  /// Short random code used in the "stop" link of broadcast SMS/email. Created on first send.
  optOutCode          String?                  @unique
  city                String?
  area                String?
  category            VendorCategory?
  source              LeadSource               @default(OTHER)
  stage               LeadStage                @default(NEW)
  lostReason          String?
  estimatedMonthlyGmv Float?
  ownerId             String?
  convertedUserId     String?                  @unique
  stageChangedAt      DateTime                 @default(now())
  liveAt              DateTime?
  lostAt              DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  owner               User?                    @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  convertedUser       User?                    @relation("LeadConvertedUser", fields: [convertedUserId], references: [id], onDelete: SetNull)
  activities          LeadActivity[]
  tasks               CrmTask[]
  prospect            Prospect?
  broadcastRecipients LeadBroadcastRecipient[]

  @@index([type, stage])
  @@index([ownerId, stage])
  @@index([phoneKey])
  @@index([email])
  @@map("leads")
}

model LeadActivity {
  id        String           @id @default(uuid())
  leadId    String
  authorId  String?
  type      LeadActivityType
  body      String
  meta      Json?
  createdAt DateTime         @default(now())
  lead      Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author    User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@map("lead_activities")
}

/// A saved lead-finder search: what staff typed plus what the rules understood from it.
model ProspectSearch {
  id              String           @id @default(uuid())
  /// The plain-language request, sent to the places provider as typed.
  query           String
  category        VendorCategory?
  city            String?
  area            String?
  minRating       Float?
  minReviews      Int?
  maxResults      Int              @default(20)
  schedule        ProspectSchedule @default(NONE)
  /// When set, scheduled runs add prospects scoring at least this straight to the pipeline.
  autoAddMinScore Int?
  nextRunAt       DateTime?
  lastRunAt       DateTime?
  createdById     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  runs            ProspectRun[]
  prospects       Prospect[]

  @@index([schedule, nextRunAt])
  @@map("prospect_searches")
}

model ProspectRun {
  id           String            @id @default(uuid())
  searchId     String
  status       ProspectRunStatus @default(QUEUED)
  scheduled    Boolean           @default(false)
  /// Billable requests made to the places provider; summed per day for the spend cap.
  placesCalls  Int               @default(0)
  found        Int               @default(0)
  added        Int               @default(0)
  alreadyKnown Int               @default(0)
  withUs       Int               @default(0)
  belowBar     Int               @default(0)
  sitesRead    Int               @default(0)
  autoAdded    Int               @default(0)
  error        String?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime          @default(now())
  search       ProspectSearch    @relation(fields: [searchId], references: [id], onDelete: Cascade)

  @@index([searchId, createdAt])
  @@index([createdAt])
  @@map("prospect_runs")
}

/// A business found on the web that might become a vendor. Becomes a Lead when staff add it.
/// Anything a source did not give stays null ("Not recorded"), never a guess.
model Prospect {
  id               String          @id @default(uuid())
  /// Provider's stable id for the business (Google place id), so re-runs update instead of duplicating.
  placeId          String          @unique
  searchId         String?
  name             String
  category         VendorCategory?
  address          String?
  city             String?
  area             String?
  lat              Float?
  lng              Float?
  phone            String?
  phoneKey         String?
  email            String?
  whatsapp         String?
  website          String?
  instagram        String?
  facebook         String?
  tiktok           String?
  twitter          String?
  youtube          String?
  mapsUrl          String?
  rating           Float?
  reviewCount      Int?
  businessStatus   String?
  /// { offersDelivery, competitors[], ordersViaChat, websiteRead }
  signals          Json?
  fitScore         Int             @default(0)
  /// Array of { label, points } explaining the score.
  fitReasons       Json?
  /// Set when the business matches a vendor already on GoBuyMe.
  existingVendorId String?
  status           ProspectStatus  @default(NEW)
  leadId           String?         @unique
  /// Staff-requested rewritten outreach messages; the standard ones are built on read.
  drafts           Json?
  enrichedAt       DateTime?
  lastSeenAt       DateTime        @default(now())
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  search           ProspectSearch? @relation(fields: [searchId], references: [id], onDelete: SetNull)
  lead             Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([status, fitScore])
  @@index([searchId, status])
  @@index([phoneKey])
  @@map("prospects")
}

/// Follow-up work for staff, optionally about a person, lead or ticket. No assignee = team queue.
model CrmTask {
  id             String       @id @default(uuid())
  title          String
  description    String?
  dueAt          DateTime?
  priority       TaskPriority @default(NORMAL)
  status         TaskStatus   @default(OPEN)
  assigneeId     String?
  createdById    String?
  relatedUserId  String?
  leadId         String?
  ticketId       String?
  completedAt    DateTime?
  reminderSentAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  assignee       User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy      User?        @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  relatedUser    User?        @relation("TaskRelatedUser", fields: [relatedUserId], references: [id], onDelete: Cascade)
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  ticket         Ticket?      @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([assigneeId, status, dueAt])
  @@index([status, dueAt])
  @@index([relatedUserId])
  @@index([leadId])
  @@index([ticketId])
  @@map("crm_tasks")
}

/// Once-per-period claim for scheduled jobs, so cluster workers don't each run the same daily job.
model JobLock {
  key       String   @id
  claimedAt DateTime @default(now())

  @@map("job_locks")
}

// One row per day the ops-briefing agent reported on (opsBriefing.service.ts). The unique `day`
// makes the 7am job idempotent across restarts and multiple server instances.
model OpsBriefing {
  id         String    @id @default(uuid())
  /// Lagos calendar day the briefing covers, YYYY-MM-DD.
  day        String    @unique
  metrics    Json
  flags      Json
  summary    Json?
  /// "llm" when Claude wrote the narrative, "rules" when it fell back to rule-based flags only.
  analyzedBy String
  model      String?
  html       String
  sentAt     DateTime?
  sendError  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("ops_briefings")
}

// ─── Agent framework (agentRuntime.service.ts) ───────────────────────────────────

enum AgentMode {
  /// Agent doesn't run.
  OFF
  /// Agent only proposes; a human approves every action.
  SUGGEST
  /// Actions listed in AgentConfig.autoActions run without approval; the rest are proposed.
  AUTO
}

enum AgentSuggestionStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTED
  FAILED
  /// The situation resolved itself (or the suggestion timed out) before anyone acted.
  EXPIRED
}

model AgentConfig {
  /// e.g. "dispatch_watcher"
  key         String    @id
  mode        AgentMode @default(SUGGEST)
  /// Action types allowed to run without approval when mode is AUTO.
  autoActions String[]  @default([])
  /// Agent-specific thresholds; defaults live in code and are merged over.
  settings    Json?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("agent_configs")
}

model AgentSuggestion {
  id           String                @id @default(uuid())
  agentKey     String
  /// Action type from the agent action registry, e.g. ASSIGN_RIDER.
  action       String
  title        String
  reason       String
  payload      Json
  orderId      String?
  ticketId     String?
  status       AgentSuggestionStatus @default(PENDING)
  /// Makes each (agent, action, situation) suggested once, across ticks and server instances.
  dedupeKey    String                @unique
  /// True when it ran without human approval (AUTO mode).
  autoExecuted Boolean               @default(false)
  decidedById  String?
  decidedAt    DateTime?
  executedAt   DateTime?
  result       Json?
  error        String?
  expiresAt    DateTime
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([status, createdAt])
  @@index([agentKey, createdAt])
  @@index([orderId])
  @@index([ticketId])
  @@map("agent_suggestions")
}

/// A platform announcement to every active user of a role (or all). Written once
/// when staff send it and never edited or deleted — it is the record of what the
/// platform said and to how many people.
model Broadcast {
  id             String              @id @default(uuid())
  authorId       String
  audience       BroadcastAudience
  /// Set only when audience is USER: the one account the message was addressed to.
  targetUserId   String?
  title          String
  body           String
  /// Accounts that were sent the message (each gets an in-app Notification row).
  recipientCount Int
  /// Of those, how many had a push token or web subscription to be buzzed on.
  pushCount      Int
  /// Delivered as an in-app Notification row + push. False for an email-only broadcast.
  sendInApp      Boolean             @default(true)
  /// Also sent by email. SERVICE reaches every active account; PROMOTIONAL skips users who opted out of marketing.
  sendEmail      Boolean             @default(false)
  emailType      BroadcastEmailType?
  /// The longer email text; falls back to `body` when null.
  emailBody      String?
  /// Accounts the email was addressed to (each one a Resend message).
  emailCount     Int                 @default(0)
  createdAt      DateTime            @default(now())
  author         User                @relation("BroadcastAuthor", fields: [authorId], references: [id])
  targetUser     User?               @relation("BroadcastTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([targetUserId])
  @@map("broadcasts")
}

enum BroadcastAudience {
  ALL
  CUSTOMERS
  VENDORS
  RIDERS
  LOGISTICS_COMPANIES
  /// One specific account (see Broadcast.targetUserId).
  USER
}

enum BroadcastEmailType {
  /// Operational news (outage, policy change): every active account in the audience.
  SERVICE
  /// Promotions and offers: only accounts with marketingOptIn, with an unsubscribe link.
  PROMOTIONAL
}

/// A logistics company that runs a fleet of riders. The owner signs in with the
/// LOGISTICS_COMPANY role and manages the fleet from their own dashboard.
model LogisticsCompany {
  id                 String         @id @default(uuid())
  userId             String         @unique
  companyName        String         @unique
  registrationNumber String?
  address            String
  city               String
  state              String         @default("Rivers")
  latitude           Float?
  longitude          Float?
  approvalStatus     ApprovalStatus @default(PENDING)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  riders             Rider[]
  invites            FleetInvite[]

  @@index([approvalStatus])
  @@map("logistics_companies")
}

enum FleetInviteStatus {
  INVITED
  CLAIMED
  REVOKED
}

/// An email invited to join a company's fleet. Claimed automatically when a rider
/// with that (verified) email signs in.
model FleetInvite {
  id        String            @id @default(uuid())
  companyId String
  /// Lower-cased invite target.
  email     String
  status    FleetInviteStatus @default(INVITED)
  expiresAt DateTime
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  company   LogisticsCompany  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, email])
  @@index([email])
  @@map("fleet_invites")
}

// ─────────────────────────────────────────────────────────────────────────────
// SMOIS — Social Media Operations & Intelligence System (internal admin module).
// Phase 1: accounts, assignments, content + approval, calendar, publishing
// records, tasks. Metrics/analytics arrive with the platform integrations
// (Phase 2); nothing here fabricates platform data. The activity trail reuses
// AuditLog (entity "Smois*"), made append-only by a DB trigger.
// ─────────────────────────────────────────────────────────────────────────────

enum SmoisRole {
  MANAGEMENT
  MANAGER
  REVIEWER
  VIEWER
}

enum SmoisPlatform {
  FACEBOOK
  INSTAGRAM
  LINKEDIN
  X
  TIKTOK
  YOUTUBE
  WHATSAPP
  PINTEREST
  THREADS
  OTHER
}

enum SmoisConnectionStatus {
  /// Registered and tracked by hand, with no API link (the only state in Phase 1).
  MANUAL
  CONNECTED
  EXPIRED
  DISCONNECTED
  ERROR
}

enum SmoisAssignmentKind {
  PRIMARY
  SECONDARY
  TEMPORARY
}

enum SmoisContentStatus {
  IDEA
  PLANNED
  BRIEFED
  IN_PRODUCTION
  SUBMITTED
  REVISION_REQUESTED
  RESUBMITTED
  APPROVED
  REJECTED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  PUBLISH_FAILED
  ARCHIVED
  CANCELLED
}

enum SmoisReviewDecision {
  APPROVED
  REJECTED
  REVISION_REQUESTED
}

enum SmoisTaskType {
  CONTENT_CREATION
  GRAPHIC_DESIGN
  VIDEO_PRODUCTION
  PUBLISHING
  COMMUNITY_MANAGEMENT
  CAMPAIGN_EXECUTION
  AUDIENCE_ENGAGEMENT
  ANALYTICS_REVIEW
  REPORTING
  COMPETITOR_RESEARCH
  SOCIAL_LISTENING
  BRAND_MONITORING
  GENERAL
}

enum SmoisTaskStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  REVISION_REQUIRED
  APPROVED
  COMPLETED
  CANCELLED
}

enum SmoisTaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SmoisRecurrence {
  DAILY
  WEEKLY
  MONTHLY
}

/// A person with SMOIS access. Super admins have implicit full access and need no row;
/// everyone else (including operations/support admins) only gets in through a row here.
model SmoisMember {
  id                  String    @id @default(uuid())
  userId              String    @unique
  role                SmoisRole
  isActive            Boolean   @default(true)
  jobTitle            String?
  responsibilities    String?
  supervisorId        String?
  assignedToDeptAt    DateTime  @default(now())
  /// Per-person switches (defaults come from the role; super admins can change them).
  canApprove          Boolean   @default(false)
  canPublish          Boolean   @default(false)
  canEmergencyPublish Boolean   @default(false)
  canConnectAccounts  Boolean   @default(false)
  revokedAt           DateTime?
  createdById         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user        User                 @relation(fields: [userId], references: [id])
  supervisor  SmoisMember?         @relation("SmoisSupervisor", fields: [supervisorId], references: [id])
  reports     SmoisMember[]        @relation("SmoisSupervisor")
  assignments SmoisAssignment[]
  tasksOwned  SmoisTask[]          @relation("SmoisTaskAssignee")
  supporting  SmoisTaskSupporter[]

  @@index([role, isActive])
  @@map("smois_members")
}

/// A company-owned social account. One record shared by every manager, never per employee.
model SmoisAccount {
  id               String                @id @default(uuid())
  platform         SmoisPlatform
  name             String
  handle           String?
  profileImageUrl  String?
  url              String?
  category         String?
  accountType      String?
  /// Company-side owner (a department/brand or named custodian), not an employee login.
  ownerLabel       String?
  connectionStatus SmoisConnectionStatus @default(MANUAL)
  apiAuthStatus    String                @default("NOT_CONNECTED")
  connectedAt      DateTime?
  lastSyncAt       DateTime?
  description      String?
  notes            String?
  archivedAt       DateTime?
  createdById      String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  assignments   SmoisAssignment[]
  variants      SmoisVariant[]
  tasks         SmoisTask[]
  snapshots     SmoisMetricSnapshot[]
  conversations SmoisConversation[]
  integration   SmoisIntegration?

  @@unique([platform, handle])
  @@index([platform, archivedAt])
  @@map("smois_accounts")
}

/// Who works on which account, with history. Ending an assignment keeps the row.
model SmoisAssignment {
  id           String              @id @default(uuid())
  accountId    String
  memberId     String
  kind         SmoisAssignmentKind @default(SECONDARY)
  startsAt     DateTime            @default(now())
  endsAt       DateTime?
  assignedById String?
  reason       String?
  endedReason  String?
  createdAt    DateTime            @default(now())

  account SmoisAccount @relation(fields: [accountId], references: [id])
  member  SmoisMember  @relation(fields: [memberId], references: [id])

  @@index([accountId, endsAt])
  @@index([memberId, endsAt])
  @@map("smois_assignments")
}

model SmoisCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  contents SmoisContent[]

  @@map("smois_categories")
}

/// The master brief. Platform-specific copy lives in variants, which are what get reviewed and published.
model SmoisContent {
  id          String    @id @default(uuid())
  number      Int       @unique @default(autoincrement())
  title       String
  description String?
  objective   String?
  categoryId  String?
  audience    String?
  format      String    @default("TEXT")
  keywords    String[]
  creatorId   String
  reviewerId  String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  campaignId String?
  category   SmoisCategory? @relation(fields: [categoryId], references: [id])
  campaign   SmoisCampaign? @relation(fields: [campaignId], references: [id])
  variants   SmoisVariant[]

  @@index([creatorId])
  @@index([archivedAt, createdAt])
  @@map("smois_contents")
}

model SmoisVariant {
  id                 String             @id @default(uuid())
  contentId          String
  accountId          String
  status             SmoisContentStatus @default(PLANNED)
  caption            String             @default("")
  hashtags           String[]
  mentions           String[]
  mediaUrls          Json               @default("[]")
  linkUrl            String?
  plannedAt          DateTime?
  scheduledAt        DateTime?
  version            Int                @default(1)
  creatorId          String
  /// Whoever last submitted it: the person who cannot also approve it.
  submittedById      String?
  submittedAt        DateTime?
  assignedReviewerId String?
  approvedById       String?
  approvedAt         DateTime?
  publishedAt        DateTime?
  publishedUrl       String?
  /// Who triggered publication and by which mechanism (MANUAL until an integration exists).
  publishedById      String?
  publishMechanism   String?
  emergencyBypass    Boolean            @default(false)
  lastReminderAt     DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  content     SmoisContent          @relation(fields: [contentId], references: [id])
  account     SmoisAccount          @relation(fields: [accountId], references: [id])
  versions    SmoisVariantVersion[]
  reviews     SmoisReview[]
  comments    SmoisComment[]
  attempts    SmoisPublishAttempt[]
  postMetrics SmoisPostMetric[]

  @@index([accountId, status])
  @@index([status, scheduledAt])
  @@index([contentId])
  @@index([creatorId])
  @@index([publishedAt])
  @@map("smois_variants")
}

/// Immutable snapshot taken whenever copy changes, so history is never overwritten.
model SmoisVariantVersion {
  id        String    @id @default(uuid())
  variantId String
  version   Int
  caption   String
  hashtags  String[]
  mentions  String[]
  mediaUrls Json
  linkUrl   String?
  plannedAt DateTime?
  editorId  String
  reason    String?
  createdAt DateTime  @default(now())

  variant SmoisVariant @relation(fields: [variantId], references: [id])

  @@unique([variantId, version])
  @@map("smois_variant_versions")
}

model SmoisReview {
  id              String              @id @default(uuid())
  variantId       String
  reviewerId      String
  decision        SmoisReviewDecision
  comments        String?
  rejectionReason String?
  versionReviewed Int
  emergencyBypass Boolean             @default(false)
  createdAt       DateTime            @default(now())

  variant SmoisVariant @relation(fields: [variantId], references: [id])

  @@index([variantId, createdAt])
  @@index([reviewerId, createdAt])
  @@map("smois_reviews")
}

model SmoisComment {
  id        String   @id @default(uuid())
  variantId String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  variant SmoisVariant @relation(fields: [variantId], references: [id])

  @@index([variantId, createdAt])
  @@map("smois_comments")
}

/// Every publish outcome, including failures. mechanism is MANUAL until an integration executes jobs.
model SmoisPublishAttempt {
  id            String   @id @default(uuid())
  variantId     String
  success       Boolean
  mechanism     String   @default("MANUAL")
  initiatedById String
  errorCode     String?
  errorMessage  String?
  publishedUrl  String?
  retryCount    Int      @default(0)
  recovery      String?
  createdAt     DateTime @default(now())

  variant SmoisVariant @relation(fields: [variantId], references: [id])

  @@index([variantId, createdAt])
  @@map("smois_publish_attempts")
}

model SmoisTask {
  id                  String            @id @default(uuid())
  number              Int               @unique @default(autoincrement())
  title               String
  description         String?
  type                SmoisTaskType     @default(GENERAL)
  priority            SmoisTaskPriority @default(NORMAL)
  status              SmoisTaskStatus   @default(PENDING)
  assigneeId          String?
  createdById         String
  accountId           String?
  startsAt            DateTime?
  deadline            DateTime?
  expectedDeliverable String?
  completionCriteria  String?
  completedAt         DateTime?
  ruleId              String?
  /// The recurrence period this occurrence stands for (e.g. "2026-11-05"), keeping generation idempotent.
  occurrenceKey       String?
  reminderSentAt      DateTime?
  overdueNotifiedAt   DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  assignee   SmoisMember?         @relation("SmoisTaskAssignee", fields: [assigneeId], references: [id])
  account    SmoisAccount?        @relation(fields: [accountId], references: [id])
  rule       SmoisRecurringRule?  @relation(fields: [ruleId], references: [id])
  supporters SmoisTaskSupporter[]
  evidence   SmoisTaskEvidence[]
  comments   SmoisTaskComment[]
  history    SmoisTaskHistory[]

  @@unique([ruleId, occurrenceKey])
  @@index([assigneeId, status])
  @@index([status, deadline])
  @@map("smois_tasks")
}

model SmoisTaskSupporter {
  taskId   String
  memberId String

  task   SmoisTask   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  member SmoisMember @relation(fields: [memberId], references: [id])

  @@id([taskId, memberId])
  @@map("smois_task_supporters")
}

model SmoisTaskEvidence {
  id        String   @id @default(uuid())
  taskId    String
  /// POST_URL | GRAPHIC | REPORT | SCREENSHOT | VIDEO | DOCUMENT | INTERACTION | OTHER
  kind      String
  url       String?
  note      String?
  addedById String
  createdAt DateTime @default(now())

  task SmoisTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("smois_task_evidence")
}

model SmoisTaskComment {
  id        String   @id @default(uuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  task SmoisTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("smois_task_comments")
}

model SmoisTaskHistory {
  id          String           @id @default(uuid())
  taskId      String
  fromStatus  SmoisTaskStatus?
  toStatus    SmoisTaskStatus
  changedById String?
  note        String?
  createdAt   DateTime         @default(now())

  task SmoisTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("smois_task_history")
}

/// Generates one SmoisTask per period (daily/weekly/monthly) for an assignee.
model SmoisRecurringRule {
  id                  String            @id @default(uuid())
  title               String
  description         String?
  type                SmoisTaskType     @default(GENERAL)
  priority            SmoisTaskPriority @default(NORMAL)
  recurrence          SmoisRecurrence
  /// 0-6 (Sun-Sat) for WEEKLY.
  dayOfWeek           Int?
  /// 1-28 for MONTHLY.
  dayOfMonth          Int?
  /// Hours after the occurrence starts that it is due.
  dueAfterHours       Int               @default(24)
  assigneeId          String?
  accountId           String?
  expectedDeliverable String?
  isActive            Boolean           @default(true)
  createdById         String
  lastGeneratedKey    String?
  createdAt           DateTime          @default(now())

  tasks SmoisTask[]

  @@map("smois_recurring_rules")
}

/// Single-row workflow configuration (id is always "default").
model SmoisSettings {
  id                    String   @id @default("default")
  requireApproval       Boolean  @default(true)
  allowSelfApproval     Boolean  @default(false)
  minPostGapMinutes     Int      @default(30)
  approvalReminderHours Int      @default(24)
  slaHighMinutes        Int      @default(30)
  slaStandardMinutes    Int      @default(120)
  slaGeneralMinutes     Int      @default(1440)
  businessStartHour     Int      @default(8)
  businessEndHour       Int      @default(18)
  businessDays          Int[]    @default([1, 2, 3, 4, 5])
  /// AI assistance is off until a super admin switches it on.
  aiEnabled             Boolean  @default(false)
  aiDailyLimit          Int      @default(30)
  updatedById           String?
  updatedAt             DateTime @updatedAt

  @@map("smois_settings")
}

/// Per-person SMOIS switches that every user can have, including super admins (who have no SmoisMember row).
model SmoisPreference {
  userId      String   @id
  /// Email copy of SMOIS alerts. In-app alerts are always on.
  emailAlerts Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  @@map("smois_preferences")
}

// ── SMOIS phase 2: analytics, targets, performance, reports ────────────────

enum SmoisReportType {
  WEEKLY_MANAGER
  MONTHLY_DEPARTMENT
  QUARTERLY_DEPARTMENT
  ANNUAL_DEPARTMENT
}

enum SmoisReportStatus {
  DRAFT
  SUBMITTED
  CLARIFICATION_REQUESTED
  APPROVED
}

/// One account on one day. followers is a running total; the other figures cover that day.
/// dataStatus says where it came from; until integrations exist everything is MANUAL.
model SmoisMetricSnapshot {
  id               String    @id @default(uuid())
  accountId        String
  snapshotDate     DateTime  @db.Date
  followers        Int?
  reach            Int?
  impressions      Int?
  engagement       Int?
  profileVisits    Int?
  videoViews       Int?
  websiteClicks    Int?
  dataStatus       String    @default("MANUAL")
  source           String    @default("Entered by hand")
  metricVersion    String    @default("v1")
  note             String?
  enteredById      String
  retrievedAt      DateTime  @default(now())
  correctedById    String?
  correctedAt      DateTime?
  correctionReason String?
  createdAt        DateTime  @default(now())

  account SmoisAccount @relation(fields: [accountId], references: [id])

  @@unique([accountId, snapshotDate])
  @@index([snapshotDate])
  @@map("smois_metric_snapshots")
}

/// A reading of one published post. Several can exist over time (early, day 7, final).
model SmoisPostMetric {
  id          String   @id @default(uuid())
  variantId   String
  recordedAt  DateTime @default(now())
  reach       Int?
  impressions Int?
  likes       Int?
  comments    Int?
  shares      Int?
  saves       Int?
  clicks      Int?
  videoViews  Int?
  dataStatus  String   @default("MANUAL")
  note        String?
  enteredById String

  variant SmoisVariant @relation(fields: [variantId], references: [id])

  @@index([variantId, recordedAt])
  @@map("smois_post_metrics")
}

model SmoisTarget {
  id                 String         @id @default(uuid())
  name               String
  metric             String
  targetValue        Float
  /// DEPARTMENT | PLATFORM | ACCOUNT | EMPLOYEE
  scope              String
  platform           SmoisPlatform?
  accountId          String?
  memberId           String?
  startsAt           DateTime
  endsAt             DateTime
  supervisorId       String?
  notes              String?
  isActive           Boolean        @default(true)
  /// The last status management was told about, so a change is announced once.
  lastNotifiedStatus String?
  createdById        String
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([scope, isActive])
  @@index([memberId])
  @@map("smois_targets")
}

/// Management's written assessment of a person for a period. Never edited or deleted, only added to.
model SmoisEvaluation {
  id          String   @id @default(uuid())
  memberId    String
  periodStart DateTime
  periodEnd   DateTime
  feedback    String
  rating      Int?
  reviewerId  String
  createdAt   DateTime @default(now())

  @@index([memberId, createdAt])
  @@map("smois_evaluations")
}

model SmoisReport {
  id            String            @id @default(uuid())
  type          SmoisReportType
  periodStart   DateTime
  periodEnd     DateTime
  authorId      String
  status        SmoisReportStatus @default(DRAFT)
  /// Figures counted from SMOIS records when the draft was generated (frozen once submitted).
  data          Json
  /// Words written by the author.
  commentary    Json              @default("{}")
  submittedAt   DateTime?
  reviewedById  String?
  reviewedAt    DateTime?
  reviewNote    String?
  dueNotifiedAt DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([authorId, type, periodStart])
  @@index([type, status])
  @@map("smois_reports")
}

// ── SMOIS phase 3: inbox, contacts, campaigns, media library, listening, competitors ──

enum SmoisConversationType {
  DIRECT_MESSAGE
  COMMENT
  MENTION
  REPLY
  STORY_INTERACTION
  ENQUIRY
  REVIEW
}

enum SmoisConversationStatus {
  NEW
  OPEN
  ASSIGNED
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  ESCALATED
  RESOLVED
  CLOSED
}

enum SmoisInboxPriority {
  HIGH
  STANDARD
  GENERAL
}

enum SmoisCampaignStatus {
  PLANNING
  BRIEFING
  PREPARATION
  APPROVAL
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum SmoisSentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
  UNCERTAIN
}

model SmoisContact {
  id           String         @id @default(uuid())
  displayName  String
  username     String?
  platform     SmoisPlatform?
  profileUrl   String?
  /// Only what the person chose to share. Never scraped.
  email        String?
  phone        String?
  location     String?
  category     String         @default("OTHER")
  assignedToId String?
  tags         String[]
  notes        String?
  consentNote  String?
  consentAt    DateTime?
  anonymizedAt DateTime?
  createdById  String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  conversations SmoisConversation[]

  @@index([platform, username])
  @@index([anonymizedAt])
  @@map("smois_contacts")
}

model SmoisConversation {
  id                  String                  @id @default(uuid())
  number              Int                     @unique @default(autoincrement())
  accountId           String
  contactId           String?
  type                SmoisConversationType   @default(DIRECT_MESSAGE)
  subject             String?
  externalUrl         String?
  status              SmoisConversationStatus @default(NEW)
  priority            SmoisInboxPriority      @default(GENERAL)
  tags                String[]
  assignedMemberId    String?
  /// When it reached the platform account (not when someone logged it here).
  receivedAt          DateTime
  slaDueAt            DateTime?
  firstResponseAt     DateTime?
  firstResponderId    String?
  resolvedAt          DateTime?
  escalationType      String?
  escalatedAt         DateTime?
  escalationNote      String?
  slaBreachNotifiedAt DateTime?
  loggedById          String
  /// The platform's own id for this interaction (set when it arrives through a connection), so it is never logged twice.
  externalId          String?
  lastActivityAt      DateTime                @default(now())
  createdAt           DateTime                @default(now())

  account  SmoisAccount   @relation(fields: [accountId], references: [id])
  contact  SmoisContact?  @relation(fields: [contactId], references: [id])
  messages SmoisMessage[]

  @@unique([accountId, externalId])
  @@index([status, priority])
  @@index([assignedMemberId, status])
  @@index([accountId, receivedAt])
  @@index([slaDueAt])
  @@map("smois_conversations")
}

model SmoisMessage {
  id             String   @id @default(uuid())
  conversationId String
  /// INBOUND (from the person), OUTBOUND (our reply, as sent on the platform) or NOTE (internal only).
  direction      String
  body           String
  authorId       String?
  occurredAt     DateTime
  createdAt      DateTime @default(now())

  conversation SmoisConversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId, occurredAt])
  @@map("smois_messages")
}

model SmoisSavedReply {
  id          String   @id @default(uuid())
  title       String
  body        String
  isActive    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())

  @@map("smois_saved_replies")
}

model SmoisCampaign {
  id              String              @id @default(uuid())
  number          Int                 @unique @default(autoincrement())
  name            String
  description     String?
  objective       String?
  type            String              @default("BRAND_AWARENESS")
  ownerId         String
  status          SmoisCampaignStatus @default(PLANNING)
  startsAt        DateTime
  endsAt          DateTime
  targetAudience  String?
  budget          Float?
  expectedResults String?
  trackingLinks   Json                @default("[]")
  lessonsLearned  String?
  recommendations String?
  createdById     String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  contents SmoisContent[]
  accounts SmoisCampaignAccount[]
  members  SmoisCampaignMember[]
  results  SmoisCampaignResult[]

  @@index([status, startsAt])
  @@map("smois_campaigns")
}

model SmoisCampaignAccount {
  campaignId String
  accountId  String

  campaign SmoisCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@id([campaignId, accountId])
  @@map("smois_campaign_accounts")
}

model SmoisCampaignMember {
  campaignId String
  memberId   String

  campaign SmoisCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@id([campaignId, memberId])
  @@map("smois_campaign_members")
}

/// Results a person copied from the platform or the ads manager. Paid and organic are kept apart.
model SmoisCampaignResult {
  id          String   @id @default(uuid())
  campaignId  String
  /// PAID | ORGANIC
  channel     String
  recordedFor DateTime @db.Date
  reach       Int?
  impressions Int?
  engagement  Int?
  clicks      Int?
  leads       Int?
  conversions Int?
  spend       Float?
  revenue     Float?
  note        String?
  enteredById String
  createdAt   DateTime @default(now())

  campaign SmoisCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, channel])
  @@map("smois_campaign_results")
}

model SmoisAsset {
  id                String    @id @default(uuid())
  name              String
  description       String?
  category          String    @default("OTHER")
  fileType          String    @default("IMAGE")
  fileSize          Int?
  url               String
  folder            String?
  tags              String[]
  version           Int       @default(1)
  /// The asset this one replaces, so version history can be walked.
  previousVersionId String?
  /// DRAFT | APPROVED | REJECTED
  approvalStatus    String    @default("DRAFT")
  approvedById      String?
  usageRestrictions String?
  expiresAt         DateTime?
  expiryNotifiedAt  DateTime?
  uploadedById      String
  archivedAt        DateTime?
  createdAt         DateTime  @default(now())

  @@index([category, archivedAt])
  @@index([expiresAt])
  @@map("smois_assets")
}

model SmoisKeyword {
  id          String   @id @default(uuid())
  term        String
  /// BRAND | PRODUCT | EXECUTIVE | INDUSTRY | HASHTAG | COMPETITOR
  kind        String   @default("BRAND")
  isActive    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())

  mentions SmoisMention[]

  @@unique([term, kind])
  @@map("smois_keywords")
}

/// A public mention a person found and logged. There is no automated monitoring.
model SmoisMention {
  id              String         @id @default(uuid())
  keywordId       String?
  platform        SmoisPlatform?
  authorName      String?
  url             String?
  text            String
  sentiment       SmoisSentiment @default(UNCERTAIN)
  /// MANUAL: chosen by whoever logged it. An assistive label, never a verdict.
  sentimentSource String         @default("MANUAL")
  reach           Int?
  occurredAt      DateTime
  handled         Boolean        @default(false)
  handledById     String?
  note            String?
  loggedById      String
  createdAt       DateTime       @default(now())

  keyword SmoisKeyword? @relation(fields: [keywordId], references: [id])

  @@index([occurredAt])
  @@index([sentiment, occurredAt])
  @@map("smois_mentions")
}

model SmoisCompetitor {
  id               String        @id @default(uuid())
  name             String
  website          String?
  platform         SmoisPlatform
  handle           String?
  url              String?
  industry         String?
  notes            String?
  monitoringStatus String        @default("ACTIVE")
  createdById      String
  createdAt        DateTime      @default(now())

  snapshots SmoisCompetitorSnapshot[]

  @@unique([platform, handle])
  @@map("smois_competitors")
}

/// What a person observed on a competitor's public profile on a given day.
model SmoisCompetitorSnapshot {
  id             String   @id @default(uuid())
  competitorId   String
  observedOn     DateTime @db.Date
  followers      Int?
  postsLast7Days Int?
  avgEngagement  Float?
  popularContent String?
  campaignNote   String?
  /// PUBLIC_OBSERVATION | ESTIMATE | THIRD_PARTY
  dataKind       String   @default("PUBLIC_OBSERVATION")
  enteredById    String
  createdAt      DateTime @default(now())

  competitor SmoisCompetitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@unique([competitorId, observedOn])
  @@map("smois_competitor_snapshots")
}

/// One row per AI request: who asked, which feature, and how it went. The question and the answer are not stored.
model SmoisAiRequest {
  id              String   @id @default(uuid())
  userId          String
  feature         String
  model           String?
  /// OK | UNAVAILABLE | DISABLED | LIMIT | ERROR
  status          String
  unverifiedCount Int      @default(0)
  durationMs      Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
  @@index([feature, createdAt])
  @@map("smois_ai_requests")
}

// ── Platform connections (scaffolding): tokens are encrypted at rest and never leave the server ──

/// One connection per account. Status: PENDING | CONNECTED | EXPIRED | REVOKED | ERROR.
model SmoisIntegration {
  id               String    @id @default(uuid())
  accountId        String    @unique
  provider         String
  status           String    @default("PENDING")
  externalId       String?
  externalName     String?
  scopes           String[]
  accessTokenEnc   String?
  refreshTokenEnc  String?
  tokenExpiresAt   DateTime?
  connectedById    String?
  connectedAt      DateTime?
  lastSyncAt       DateTime?
  nextSyncAt       DateTime?
  lastError        String?
  lastErrorAt      DateTime?
  rateLimitedUntil DateTime?
  expiryNotifiedAt DateTime?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  account SmoisAccount   @relation(fields: [accountId], references: [id])
  jobs    SmoisSyncJob[]

  @@index([status, nextSyncAt])
  @@map("smois_integrations")
}

/// One row per synchronisation run (PRD 28.5): what ran, how it ended, how much it processed.
model SmoisSyncJob {
  id               String    @id @default(uuid())
  integrationId    String
  accountId        String
  /// RUNNING | OK | PARTIAL | FAILED | RETRY
  status           String    @default("RUNNING")
  /// SCHEDULE | MANUAL | RETRY
  trigger          String    @default("SCHEDULE")
  requestedById    String?
  startedAt        DateTime  @default(now())
  finishedAt       DateTime?
  recordsProcessed Int       @default(0)
  recordsSkipped   Int       @default(0)
  attempt          Int       @default(1)
  nextRetryAt      DateTime?
  error            String?

  integration SmoisIntegration @relation(fields: [integrationId], references: [id])

  @@index([integrationId, startedAt])
  @@index([status, nextRetryAt])
  @@map("smois_sync_jobs")
}

/// Webhook deliveries already handled, so a repeated delivery does nothing twice.
model SmoisWebhookEvent {
  id          String    @id @default(uuid())
  provider    String
  eventKey    String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  outcome     String?

  @@unique([provider, eventKey])
  @@map("smois_webhook_events")
}

/// A phone number or email that must never receive lead marketing again. Kept apart from Lead so an
/// opt-out survives the lead being deleted or the same business being found again.
model OutreachSuppression {
  id        String          @id @default(uuid())
  channel   CampaignChannel
  /// Last 10 digits of the phone (SMS) or the lowercase email (EMAIL).
  key       String
  reason    String?
  createdAt DateTime        @default(now())

  @@unique([channel, key])
  @@map("outreach_suppressions")
}

/// A staff-confirmed bulk SMS/email to pipeline leads. Social profiles are never broadcast to.
model LeadBroadcast {
  id           String                   @id @default(uuid())
  name         String
  channels     CampaignChannel[]
  body         String
  emailSubject String?
  ctaUrl       String?
  /// The filters staff chose, kept so the send can be explained later.
  filters      Json
  status       CampaignStatus           @default(SENDING)
  audienceSize Int                      @default(0)
  createdById  String
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  createdBy    User                     @relation("LeadBroadcastCreator", fields: [createdById], references: [id])
  recipients   LeadBroadcastRecipient[]

  @@index([status, createdAt])
  @@map("lead_broadcasts")
}

model LeadBroadcastRecipient {
  id          String          @id @default(uuid())
  broadcastId String
  leadId      String
  channel     CampaignChannel
  status      RecipientStatus @default(PENDING)
  error       String?
  sentAt      DateTime?
  createdAt   DateTime        @default(now())
  /// Bumped on every status change; used to detect sends interrupted mid-flight.
  updatedAt   DateTime        @updatedAt
  broadcast   LeadBroadcast   @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  lead        Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, leadId, channel])
  @@index([broadcastId, status])
  @@index([leadId, sentAt])
  @@index([channel, createdAt])
  @@map("lead_broadcast_recipients")
}

// ─────────────────────────────────────────────────────────────────────────────
// PWM: People & Workforce Management (Phase 1). Admin module under /pwm.
// User ids are stored as plain strings (no FK) so staff data never blocks a user clean-up;
// names are joined in the controllers. HR activity goes to AuditLog with entity "Pwm*" (append-only).
// ─────────────────────────────────────────────────────────────────────────────

enum PwmRole {
  HR_ADMIN
  HR_OFFICER
  DEPARTMENT_HEAD
  EXECUTIVE
  FINANCE
  AUDITOR
}

enum PwmEmploymentStatus {
  PENDING_ONBOARDING
  PROBATION
  ACTIVE
  RENEWAL_PENDING
  CONTRACT_ISSUED
  ON_LEAVE
  SUSPENDED
  NOTICE_PERIOD
  CONTRACT_EXPIRED
  RESIGNED
  TERMINATED
  ARCHIVED
}

enum PwmContractStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ISSUED
  SIGNED
  ACTIVE
  RENEWAL_PENDING
  EXPIRED_ACTION_REQUIRED
  EXPIRED
  NOT_RENEWED
  SUPERSEDED
  TERMINATED_EARLY
  DECLINED
  CANCELLED
  ARCHIVED
}

enum PwmApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum PwmRenewalDecision {
  RENEW_SAME_TERMS
  RENEW_WITH_CHANGES
  EXTEND
  CONVERT_TO_PERMANENT
  DO_NOT_RENEW
  OTHER
}

enum PwmRenewalStep {
  RECOMMENDATION
  DECISION
  PREPARATION
  ISSUANCE
  SIGNATURE
  COMPLETED
  CLOSED
}

enum PwmReminderStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  CANCELLED
}

enum PwmChecklistKind {
  ONBOARDING
  OFFBOARDING
}

enum PwmTaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  SKIPPED
}

/// Who may use PWM besides super admins, and at what level.
model PwmMember {
  id                  String    @id @default(uuid())
  userId              String    @unique
  role                PwmRole
  isActive            Boolean   @default(true)
  jobTitle            String?
  /// Receives the T-1 / T0 / T+n alerts meant for the Managing Director.
  isMd                Boolean   @default(false)
  /// HR administrators only see pay when this is switched on (PRD 13.2 note).
  canViewCompensation Boolean   @default(false)
  revokedAt           DateTime?
  createdById         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([role, isActive])
  @@map("pwm_members")
}

model PwmSettings {
  id          String   @id @default("default")
  config      Json     @default("{}")
  updatedById String?
  updatedAt   DateTime @updatedAt

  @@map("pwm_settings")
}

model PwmCounter {
  key   String @id
  value Int    @default(0)

  @@map("pwm_counters")
}

model PwmDepartment {
  id             String    @id @default(uuid())
  name           String    @unique
  code           String?
  parentId       String?
  headEmployeeId String?
  isActive       Boolean   @default(true)
  archivedAt     DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  parent    PwmDepartment?  @relation("PwmDeptTree", fields: [parentId], references: [id])
  children  PwmDepartment[] @relation("PwmDeptTree")
  head      PwmEmployee?    @relation("PwmDeptHead", fields: [headEmployeeId], references: [id])
  employees PwmEmployee[]   @relation("PwmEmployeeDept")

  @@map("pwm_departments")
}

model PwmEmployee {
  id                String              @id @default(uuid())
  employeeNo        String              @unique
  /// Link to a system login, when the person has one (needed to receive alerts).
  userId            String?             @unique
  title             String?
  firstName         String
  middleName        String?
  lastName          String
  knownAs           String?
  photoUrl          String?
  dateOfBirth       DateTime?           @db.Date
  sex               String?
  maritalStatus     String?
  nationality       String?
  stateOfOrigin     String?
  workEmail         String?             @unique
  personalEmail     String?
  phone             String?
  address           String?
  emergencyContacts Json?
  nextOfKin         Json?
  guarantors        Json?
  companyEntity     String              @default("Main")
  departmentId      String?
  jobTitle          String
  grade             String?
  managerId         String?
  location          String?
  workArrangement   String              @default("ON_SITE")
  hireDate          DateTime            @db.Date
  originalHireDate  DateTime?           @db.Date
  employmentType    String
  status            PwmEmploymentStatus @default(PENDING_ONBOARDING)
  probationEndDate  DateTime?           @db.Date
  confirmationDate  DateTime?           @db.Date
  costCentre        String?
  hrOfficerUserId   String?
  /// Highly restricted: AES-256-GCM encrypted, never returned in lists, revealed only with a logged reason.
  nin               String?
  tin               String?
  rsaPin            String?
  pfaName           String?
  nhfNo             String?
  bankName          String?
  bankAccountNo     String?
  bankAccountName   String?
  exitType          String?
  exitDate          DateTime?           @db.Date
  finalWorkingDay   DateTime?           @db.Date
  exitReason        String?
  rehireEligible    Boolean?
  employmentEpisode Int                 @default(1)
  archivedAt        DateTime?
  createdById       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  version           Int                 @default(1)

  department       PwmDepartment?            @relation("PwmEmployeeDept", fields: [departmentId], references: [id])
  headOf           PwmDepartment[]           @relation("PwmDeptHead")
  manager          PwmEmployee?              @relation("PwmReporting", fields: [managerId], references: [id])
  reports          PwmEmployee[]             @relation("PwmReporting")
  contracts        PwmContract[]
  renewals         PwmRenewal[]
  statusLog        PwmStatusChange[]
  documents        PwmDocument[]
  checklists       PwmChecklist[]
  compensation     PwmCompensation[]
  scheduleId       String?
  schedule         PwmSchedule?              @relation(fields: [scheduleId], references: [id])
  leaveBalances    PwmLeaveBalance[]
  leaveRequests    PwmLeaveRequest[]
  attendance       PwmAttendance[]
  corrections      PwmAttendanceCorrection[]
  overtime         PwmOvertime[]
  reviews          PwmReview[]
  objectives       PwmObjective[]
  enrolments       PwmEnrolment[]
  devPlans         PwmDevelopmentPlan[]
  skillAssessments PwmSkillAssessment[]
  assetAssignments PwmAssetAssignment[]
  cases            PwmCase[]
  recognitions     PwmRecognition[]
  expenseClaims    PwmExpenseClaim[]
  travelRequests   PwmTravelRequest[]

  @@index([status])
  @@index([departmentId])
  @@index([lastName, firstName])
  @@map("pwm_employees")
}

model PwmStatusChange {
  id             String              @id @default(uuid())
  employeeId     String
  fromStatus     PwmEmploymentStatus
  toStatus       PwmEmploymentStatus
  effectiveDate  DateTime            @db.Date
  reason         String
  requestedById  String?
  /// True when the system itself made the change (only Renewal pending / Contract expired are allowed).
  bySystem       Boolean             @default(false)
  approvalStatus PwmApprovalStatus   @default(NOT_REQUIRED)
  approvedById   String?
  approvedAt     DateTime?
  decisionNote   String?
  appliedAt      DateTime?
  createdAt      DateTime            @default(now())

  employee PwmEmployee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, createdAt])
  @@index([approvalStatus, appliedAt])
  @@map("pwm_status_changes")
}

model PwmContract {
  id                       String              @id @default(uuid())
  reference                String              @unique
  employeeId               String
  departmentName           String?
  jobTitle                 String?
  contractType             String
  status                   PwmContractStatus   @default(DRAFT)
  commencementDate         DateTime            @db.Date
  expiryDate               DateTime?           @db.Date
  renewalEligibility       String              @default("SUBJECT_TO_REVIEW")
  renewalEligibilityNote   String?
  probationMonths          Int?
  probationEndDate         DateTime?           @db.Date
  noticeValue              Int?
  noticeUnit               String?
  workingPattern           String?
  hoursPerWeek             Int?
  approvalStatus           PwmApprovalStatus   @default(NOT_REQUIRED)
  approvedById             String?
  approvedAt               DateTime?
  approvalNote             String?
  issuedAt                 DateTime?
  issuedById               String?
  signedDate               DateTime?           @db.Date
  countersignedDate        DateTime?           @db.Date
  renewalDecision          PwmRenewalDecision?
  decidedById              String?
  /// Set when an authorised decision is recorded; stops the expiry reminders (PRD REM-05).
  decisionRecordedAt       DateTime?
  predecessorId            String?             @unique
  templateName             String?
  responsibleOfficerUserId String?
  isImported               Boolean             @default(false)
  notes                    String?
  archivedAt               DateTime?
  createdById              String?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  version                  Int                 @default(1)

  employee    PwmEmployee            @relation(fields: [employeeId], references: [id])
  predecessor PwmContract?           @relation("PwmContractChain", fields: [predecessorId], references: [id])
  successor   PwmContract?           @relation("PwmContractChain")
  amendments  PwmContractAmendment[]
  documents   PwmDocument[]
  renewals    PwmRenewal[]
  tiers       PwmReminderTier[]
  reminders   PwmReminder[]

  @@index([status, expiryDate])
  @@index([employeeId])
  @@map("pwm_contracts")
}

model PwmContractAmendment {
  id               String    @id @default(uuid())
  contractId       String
  effectiveDate    DateTime  @db.Date
  summary          String
  newExpiryDate    DateTime? @db.Date
  documentUrl      String?
  documentChecksum String?
  createdById      String?
  createdAt        DateTime  @default(now())

  contract PwmContract @relation(fields: [contractId], references: [id])

  @@index([contractId])
  @@map("pwm_contract_amendments")
}

/// Files and certifications. Contract PDFs are versions of the same category, none are overwritten.
model PwmDocument {
  id           String    @id @default(uuid())
  employeeId   String
  contractId   String?
  /// DOCUMENT or CERTIFICATION
  kind         String    @default("DOCUMENT")
  category     String
  name         String
  issuer       String?
  number       String?
  issueDate    DateTime? @db.Date
  expiryDate   DateTime? @db.Date
  url          String
  checksum     String?
  restricted   Boolean   @default(false)
  version      Int       @default(1)
  uploadedById String?
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())

  employee PwmEmployee  @relation(fields: [employeeId], references: [id])
  contract PwmContract? @relation(fields: [contractId], references: [id])

  @@index([employeeId, kind])
  @@index([expiryDate])
  @@map("pwm_documents")
}

model PwmRenewal {
  id                  String              @id @default(uuid())
  contractId          String
  employeeId          String
  step                PwmRenewalStep      @default(RECOMMENDATION)
  recommendation      PwmRenewalDecision?
  recommendationNote  String?
  recommendedById     String?
  recommendedAt       DateTime?
  decision            PwmRenewalDecision?
  decisionNote        String?
  decidedById         String?
  decidedAt           DateTime?
  newExpiryDate       DateTime?           @db.Date
  successorContractId String?
  dueRecommendation   DateTime            @db.Date
  dueDecision         DateTime            @db.Date
  duePreparation      DateTime            @db.Date
  dueIssuance         DateTime            @db.Date
  dueSignature        DateTime            @db.Date
  completedAt         DateTime?
  closedReason        String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  contract PwmContract       @relation(fields: [contractId], references: [id])
  employee PwmEmployee       @relation(fields: [employeeId], references: [id])
  events   PwmRenewalEvent[]

  @@index([step])
  @@index([contractId])
  @@map("pwm_renewals")
}

/// Approval history kept permanently against the contract (PRD REN-09).
model PwmRenewalEvent {
  id        String   @id @default(uuid())
  renewalId String
  action    String
  actorId   String?
  note      String?
  createdAt DateTime @default(now())

  renewal PwmRenewal @relation(fields: [renewalId], references: [id])

  @@index([renewalId, createdAt])
  @@map("pwm_renewal_events")
}

/// One row per contract, tier and expiry date: the reminder engine remembers what it has already decided.
model PwmReminderTier {
  id         String   @id @default(uuid())
  contractId String
  tierKey    String
  expiryDate DateTime @db.Date
  /// DISPATCHED, SKIPPED_CATCHUP, SUPPRESSED_IMPORT
  outcome    String
  note       String?
  createdAt  DateTime @default(now())

  contract PwmContract @relation(fields: [contractId], references: [id])

  @@unique([contractId, tierKey, expiryDate])
  @@map("pwm_reminder_tiers")
}

model PwmReminder {
  id              String            @id @default(uuid())
  /// CONTRACT_EXPIRY, PROBATION, CERTIFICATION, RENEWAL_SLA, CONFIG_GAP
  kind            String
  contractId      String?
  employeeId      String?
  documentId      String?
  renewalId       String?
  tierKey         String
  severity        String            @default("INFO")
  expiryDate      DateTime?         @db.Date
  recipientUserId String
  recipientRole   String
  channel         String
  idempotencyKey  String            @unique
  title           String
  body            String
  link            String?
  requiresAck     Boolean           @default(false)
  status          PwmReminderStatus @default(QUEUED)
  scheduledFor    DateTime          @default(now())
  sentAt          DateTime?
  attempts        Int               @default(0)
  nextAttemptAt   DateTime?
  lastError       String?
  readAt          DateTime?
  acknowledgedAt  DateTime?
  escalatedAt     DateTime?
  cancelReason    String?
  createdAt       DateTime          @default(now())

  contract PwmContract? @relation(fields: [contractId], references: [id])

  @@index([recipientUserId, status])
  @@index([status, nextAttemptAt])
  @@index([contractId])
  @@map("pwm_reminders")
}

model PwmChecklist {
  id            String           @id @default(uuid())
  employeeId    String
  kind          PwmChecklistKind
  startDate     DateTime         @db.Date
  /// OPEN, COMPLETED or CANCELLED
  status        String           @default("OPEN")
  completedAt   DateTime?
  completedById String?
  createdById   String?
  createdAt     DateTime         @default(now())

  employee PwmEmployee        @relation(fields: [employeeId], references: [id])
  tasks    PwmChecklistTask[]

  @@index([employeeId, kind])
  @@index([status])
  @@map("pwm_checklists")
}

model PwmChecklistTask {
  id             String        @id @default(uuid())
  checklistId    String
  stage          String
  title          String
  /// HR_OFFICER, DEPARTMENT_HEAD, IT, ASSETS, FINANCE, EMPLOYEE, HR_ADMIN
  ownerRole      String
  assigneeUserId String?
  dueDate        DateTime?     @db.Date
  mandatory      Boolean       @default(true)
  status         PwmTaskStatus @default(PENDING)
  completedAt    DateTime?
  completedById  String?
  note           String?
  sortOrder      Int           @default(0)

  checklist PwmChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  @@index([checklistId])
  @@index([assigneeUserId, status])
  @@map("pwm_checklist_tasks")
}

/// Effective-dated pay. Prepared by one person and approved by another (segregation of duties).
model PwmCompensation {
  id             String            @id @default(uuid())
  employeeId     String
  effectiveFrom  DateTime          @db.Date
  effectiveTo    DateTime?         @db.Date
  baseSalary     Decimal           @db.Decimal(14, 2)
  currency       String            @default("NGN")
  /// [{ name, amount }] allowances, bonuses, deductions
  components     Json?
  reason         String
  approvalStatus PwmApprovalStatus @default(PENDING)
  preparedById   String?
  approvedById   String?
  approvedAt     DateTime?
  decisionNote   String?
  createdAt      DateTime          @default(now())

  employee PwmEmployee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, effectiveFrom])
  @@map("pwm_compensation")
}

// ─────────────────────────────────────────────────────────────────────────────
// PWM Phase 2: recruitment, policies, announcements, templates, exit, self-service, pre-boarding.
// ─────────────────────────────────────────────────────────────────────────────

enum PwmVacancyStatus {
  DRAFT
  PENDING_APPROVAL
  OPEN
  ON_HOLD
  FILLED
  CLOSED
}

enum PwmApplicationStage {
  APPLIED
  SCREENING
  INTERVIEW
  ASSESSMENT
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

model PwmVacancy {
  id              String           @id @default(uuid())
  reference       String           @unique
  title           String
  departmentId    String?
  hiringManagerId String?
  employmentType  String
  location        String?
  headcount       Int              @default(1)
  description     String?
  requirements    String?
  status          PwmVacancyStatus @default(DRAFT)
  /// Shown on the public careers page once open.
  isPublic        Boolean          @default(false)
  closingDate     DateTime?        @db.Date
  openedAt        DateTime?
  approvedById    String?
  approvedAt      DateTime?
  createdById     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  applications PwmApplication[]

  @@index([status])
  @@map("pwm_vacancies")
}

model PwmCandidate {
  id           String    @id @default(uuid())
  firstName    String
  lastName     String
  email        String    @unique
  phone        String?
  source       String?
  cvUrl        String?
  notes        String?
  /// When the person agreed to us holding their details (NDPA). Public applicants tick this box.
  consentAt    DateTime?
  anonymisedAt DateTime?
  createdAt    DateTime  @default(now())

  applications PwmApplication[]

  @@map("pwm_candidates")
}

model PwmApplication {
  id              String              @id @default(uuid())
  vacancyId       String
  candidateId     String
  stage           PwmApplicationStage @default(APPLIED)
  rating          Int?
  notes           String?
  coverNote       String?
  rejectionReason String?
  offerNotes      String?
  offeredAt       DateTime?
  hiredEmployeeId String?
  stageChangedAt  DateTime            @default(now())
  createdAt       DateTime            @default(now())

  vacancy    PwmVacancy     @relation(fields: [vacancyId], references: [id])
  candidate  PwmCandidate   @relation(fields: [candidateId], references: [id])
  interviews PwmInterview[]

  @@unique([vacancyId, candidateId])
  @@index([vacancyId, stage])
  @@map("pwm_applications")
}

model PwmInterview {
  id            String   @id @default(uuid())
  applicationId String
  scheduledAt   DateTime
  mode          String   @default("IN_PERSON")
  location      String?
  /// Login ids of the interviewers.
  panelUserIds  Json?
  /// SCHEDULED, COMPLETED or CANCELLED
  status        String   @default("SCHEDULED")
  /// [{ userId, score, notes }]
  feedback      Json?
  createdById   String?
  createdAt     DateTime @default(now())

  application PwmApplication @relation(fields: [applicationId], references: [id])

  @@index([applicationId])
  @@index([scheduledAt])
  @@map("pwm_interviews")
}

model PwmPolicy {
  id            String    @id @default(uuid())
  /// Versions of one policy share a slug.
  slug          String
  title         String
  category      String?
  version       Int       @default(1)
  body          String?
  fileUrl       String?
  /// DRAFT, PUBLISHED or ARCHIVED
  status        String    @default("DRAFT")
  requiresAck   Boolean   @default(true)
  effectiveDate DateTime? @db.Date
  publishedAt   DateTime?
  createdById   String?
  createdAt     DateTime  @default(now())

  acks PwmPolicyAck[]

  @@unique([slug, version])
  @@index([status])
  @@map("pwm_policies")
}

model PwmPolicyAck {
  id         String   @id @default(uuid())
  policyId   String
  employeeId String
  ackedAt    DateTime @default(now())
  ip         String?

  policy PwmPolicy @relation(fields: [policyId], references: [id])

  @@unique([policyId, employeeId])
  @@index([employeeId])
  @@map("pwm_policy_acks")
}

model PwmAnnouncement {
  id            String    @id @default(uuid())
  title         String
  body          String
  /// null = everyone; otherwise department ids
  departmentIds Json?
  publishAt     DateTime  @default(now())
  expiresAt     DateTime?
  pinned        Boolean   @default(false)
  createdById   String?
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([publishAt])
  @@map("pwm_announcements")
}

/// Contract and letter templates with {{merge.fields}}. Only approved templates can be used.
model PwmTemplate {
  id           String    @id @default(uuid())
  slug         String
  name         String
  /// CONTRACT, LETTER or EXIT
  kind         String
  version      Int       @default(1)
  body         String
  /// DRAFT, APPROVED or ARCHIVED
  status       String    @default("DRAFT")
  approvedById String?
  approvedAt   DateTime?
  createdById  String?
  createdAt    DateTime  @default(now())

  @@unique([slug, version])
  @@index([status, kind])
  @@map("pwm_templates")
}

model PwmExitInterview {
  id             String   @id @default(uuid())
  employeeId     String
  episode        Int      @default(1)
  reasonCategory String?
  wouldRecommend Boolean?
  /// [{ question, answer }]
  answers        Json?
  /// Confidential interviews are visible to the HR administrator and the person who held them only.
  confidential   Boolean  @default(true)
  conductedById  String?
  conductedAt    DateTime @default(now())

  @@unique([employeeId, episode])
  @@map("pwm_exit_interviews")
}

model PwmClearance {
  id         String    @id @default(uuid())
  employeeId String
  episode    Int       @default(1)
  /// DEPARTMENT, IT, FINANCE, ASSETS, HR
  area       String
  /// PENDING, CLEARED or BLOCKED
  status     String    @default("PENDING")
  note       String?
  signedById String?
  signedAt   DateTime?

  @@unique([employeeId, episode, area])
  @@map("pwm_clearances")
}

/// A change the employee asked for that HR must verify before it takes effect (bank details).
model PwmChangeRequest {
  id           String            @id @default(uuid())
  employeeId   String
  /// BANK
  kind         String
  /// Encrypted JSON of the requested values
  payloadEnc   String
  status       PwmApprovalStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  note         String?
  createdAt    DateTime          @default(now())

  @@index([status])
  @@index([employeeId])
  @@map("pwm_change_requests")
}

/// A pre-boarding link for a new hire: expiring token plus an emailed one-time code.
model PwmPreboarding {
  id          String    @id @default(uuid())
  employeeId  String
  tokenHash   String    @unique
  otpHash     String?
  otpExpires  DateTime?
  otpAttempts Int       @default(0)
  verifiedAt  DateTime?
  expiresAt   DateTime
  submittedAt DateTime?
  revokedAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([employeeId])
  @@map("pwm_preboarding")
}

// ─────────────────────────────────────────────────────────────────────────────
// PWM Phase 3: leave, attendance, performance, public holidays.
// ─────────────────────────────────────────────────────────────────────────────

enum PwmLeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model PwmHoliday {
  id       String   @id @default(uuid())
  date     DateTime @db.Date
  name     String
  location String?

  @@unique([date, name])
  @@map("pwm_holidays")
}

/// Leave policy as data (PRD LEV-01): entitlement, accrual, carry-over, approval chain.
model PwmLeaveType {
  id                 String  @id @default(uuid())
  key                String  @unique
  name               String
  annualDays         Decimal @default(0) @db.Decimal(5, 1)
  /// UPFRONT or MONTHLY
  accrual            String  @default("UPFRONT")
  afterProbationOnly Boolean @default(false)
  minTenureMonths    Int     @default(0)
  carryOverCap       Decimal @default(0) @db.Decimal(5, 1)
  maxConsecutiveDays Int?
  allowHalfDay       Boolean @default(true)
  /// A document is needed once a request is longer than this many working days.
  docAfterDays       Int?
  paid               Boolean @default(true)
  allowNegative      Boolean @default(false)
  /// Ordered approval steps: SUPERVISOR, DEPT_HEAD, HR
  approvalChain      Json
  /// Long leave puts the employee on leave status for the period.
  setsOnLeaveStatus  Boolean @default(false)
  /// Calendar days (weekends count), for statutory leaves like maternity.
  countsWeekends     Boolean @default(false)
  active             Boolean @default(true)
  sortOrder          Int     @default(0)

  balances PwmLeaveBalance[]
  requests PwmLeaveRequest[]

  @@map("pwm_leave_types")
}

model PwmLeaveBalance {
  id          String  @id @default(uuid())
  employeeId  String
  typeId      String
  year        Int
  entitled    Decimal @default(0) @db.Decimal(6, 1)
  carriedOver Decimal @default(0) @db.Decimal(6, 1)
  adjusted    Decimal @default(0) @db.Decimal(6, 1)
  used        Decimal @default(0) @db.Decimal(6, 1)

  employee PwmEmployee  @relation(fields: [employeeId], references: [id])
  type     PwmLeaveType @relation(fields: [typeId], references: [id])

  @@unique([employeeId, typeId, year])
  @@map("pwm_leave_balances")
}

model PwmLeaveRequest {
  id                 String         @id @default(uuid())
  employeeId         String
  typeId             String
  startDate          DateTime       @db.Date
  endDate            DateTime       @db.Date
  startHalf          Boolean        @default(false)
  endHalf            Boolean        @default(false)
  /// Working days this request takes from the balance.
  days               Decimal        @db.Decimal(5, 1)
  reason             String?
  docUrl             String?
  handoverEmployeeId String?
  status             PwmLeaveStatus @default(PENDING)
  currentStep        Int            @default(0)
  /// Login that submitted it (the employee, or HR on their behalf).
  requestedById      String?
  cancelReason       String?
  decidedAt          DateTime?
  createdAt          DateTime       @default(now())

  employee  PwmEmployee        @relation(fields: [employeeId], references: [id])
  type      PwmLeaveType       @relation(fields: [typeId], references: [id])
  approvals PwmLeaveApproval[]

  @@index([employeeId, startDate])
  @@index([status])
  @@map("pwm_leave_requests")
}

model PwmLeaveApproval {
  id             String    @id @default(uuid())
  requestId      String
  step           Int
  /// SUPERVISOR, DEPT_HEAD or HR
  role           String
  approverUserId String?
  /// APPROVED or REJECTED once acted on
  decision       String?
  note           String?
  actedById      String?
  actedAt        DateTime?

  request PwmLeaveRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([approverUserId])
  @@map("pwm_leave_approvals")
}

model PwmLeaveAdjustment {
  id         String   @id @default(uuid())
  employeeId String
  typeId     String
  year       Int
  delta      Decimal  @db.Decimal(6, 1)
  reason     String
  byUserId   String?
  createdAt  DateTime @default(now())

  @@index([employeeId])
  @@map("pwm_leave_adjustments")
}

model PwmSchedule {
  id           String  @id @default(uuid())
  name         String  @unique
  startTime    String
  endTime      String
  breakMinutes Int     @default(60)
  /// ISO weekdays, Monday = 1
  workDays     Json
  graceMinutes Int     @default(15)
  isDefault    Boolean @default(false)
  active       Boolean @default(true)

  employees PwmEmployee[]

  @@map("pwm_schedules")
}

model PwmAttendance {
  id            String    @id @default(uuid())
  employeeId    String
  date          DateTime  @db.Date
  clockIn       DateTime?
  clockOut      DateTime?
  /// PRESENT, LATE, ABSENT, ON_LEAVE, HOLIDAY, REMOTE or EXCUSED
  status        String
  minutesLate   Int       @default(0)
  minutesEarly  Int       @default(0)
  minutesWorked Int       @default(0)
  source        String    @default("WEB")
  explanation   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  employee PwmEmployee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
  @@index([date, status])
  @@map("pwm_attendance")
}

/// A change to a recorded day. The original values are kept on the request, so the history is never lost (ATT-07).
model PwmAttendanceCorrection {
  id             String            @id @default(uuid())
  employeeId     String
  date           DateTime          @db.Date
  originalIn     DateTime?
  originalOut    DateTime?
  requestedIn    DateTime?
  requestedOut   DateTime?
  reason         String
  status         PwmApprovalStatus @default(PENDING)
  approverUserId String?
  decidedById    String?
  decidedAt      DateTime?
  note           String?
  createdAt      DateTime          @default(now())

  employee PwmEmployee @relation(fields: [employeeId], references: [id])

  @@index([status])
  @@map("pwm_attendance_corrections")
}

model PwmOvertime {
  id             String            @id @default(uuid())
  employeeId     String
  date           DateTime          @db.Date
  hours          Decimal           @db.Decimal(4, 1)
  reason         String
  status         PwmApprovalStatus @default(PENDING)
  approverUserId String?
  decidedById    String?
  decidedAt      DateTime?
  note           String?
  createdAt      DateTime          @default(now())

  employee PwmEmployee @relation(fields: [employeeId], references: [id])

  @@index([status])
  @@map("pwm_overtime")
}

model PwmReviewCycle {
  id          String   @id @default(uuid())
  name        String
  /// MONTHLY, QUARTERLY, ANNUAL, PROBATION, RENEWAL or ADHOC
  type        String
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  dueDate     DateTime @db.Date
  /// OPEN or CLOSED
  status      String   @default("OPEN")
  createdById String?
  createdAt   DateTime @default(now())

  reviews PwmReview[]

  @@map("pwm_review_cycles")
}

model PwmReview {
  id             String    @id @default(uuid())
  cycleId        String
  employeeId     String
  /// The manager who assesses (a login id)
  reviewerUserId String?
  /// SELF, MANAGER, DISCUSSION or ACKNOWLEDGED
  status         String    @default("SELF")
  selfRating     Int?
  selfComment    String?
  selfAt         DateTime?
  managerRating  Int?
  managerComment String?
  strengths      String?
  improvements   String?
  summary        String?
  managerAt      DateTime?
  discussedAt    DateTime?
  ackedAt        DateTime?
  ackComment     String?
  reopenedAt     DateTime?
  reopenReason   String?
  createdAt      DateTime  @default(now())

  cycle    PwmReviewCycle @relation(fields: [cycleId], references: [id])
  employee PwmEmployee    @relation(fields: [employeeId], references: [id])

  @@unique([cycleId, employeeId])
  @@index([status])
  @@map("pwm_reviews")
}

model PwmObjective {
  id           String    @id @default(uuid())
  employeeId   String?
  departmentId String?
  /// Individual objectives can point at the department target they serve (cascade).
  parentId     String?
  title        String
  description  String?
  measure      String?
  target       String?
  weight       Int       @default(0)
  dueDate      DateTime? @db.Date
  progress     Int       @default(0)
  /// ACTIVE, ACHIEVED, MISSED or CANCELLED
  status       String    @default("ACTIVE")
  createdById  String?
  createdAt    DateTime  @default(now())

  employee PwmEmployee? @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([departmentId])
  @@map("pwm_objectives")
}

model PwmFeedbackNote {
  id                 String   @id @default(uuid())
  employeeId         String
  authorUserId       String
  /// PRAISE, IMPROVE or NOTE
  kind               String
  text               String
  sharedWithEmployee Boolean  @default(false)
  createdAt          DateTime @default(now())

  @@index([employeeId, createdAt])
  @@map("pwm_feedback_notes")
}

model PwmImprovementPlan {
  id          String    @id @default(uuid())
  employeeId  String
  reason      String
  startDate   DateTime  @db.Date
  reviewDate  DateTime  @db.Date
  objectives  String
  support     String?
  /// [{ title, dueDate, done }]
  milestones  Json?
  /// ACTIVE, PASSED, EXTENDED or FAILED
  status      String    @default("ACTIVE")
  outcomeNote String?
  createdById String?
  closedAt    DateTime?
  createdAt   DateTime  @default(now())

  @@index([employeeId])
  @@map("pwm_improvement_plans")
}

// ─────────────────────────────────────────────────────────────────────────────
// PWM Phase 4: learning, skills, assets, employee relations, recognition, surveys, expenses, travel.
// ─────────────────────────────────────────────────────────────────────────────

model PwmCourse {
  id               String   @id @default(uuid())
  title            String
  provider         String?
  /// CLASSROOM, ONLINE, ON_THE_JOB or EXTERNAL
  mode             String   @default("ONLINE")
  cost             Decimal  @default(0) @db.Decimal(12, 2)
  durationHours    Decimal  @default(0) @db.Decimal(6, 1)
  /// Required of everyone (for example data protection awareness).
  mandatory        Boolean  @default(false)
  /// Mandatory courses must be repeated this often.
  recurrenceMonths Int?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())

  enrolments PwmEnrolment[]

  @@map("pwm_courses")
}

model PwmEnrolment {
  id             String    @id @default(uuid())
  courseId       String
  employeeId     String
  /// REQUESTED, APPROVED, COMPLETED, REJECTED or CANCELLED
  status         String    @default("REQUESTED")
  /// Assigned by HR or a manager, not asked for by the employee.
  assigned       Boolean   @default(false)
  cost           Decimal   @default(0) @db.Decimal(12, 2)
  requestedById  String?
  approverUserId String?
  decidedById    String?
  decidedAt      DateTime?
  note           String?
  completedAt    DateTime?
  certificateUrl String?
  createdAt      DateTime  @default(now())

  course   PwmCourse   @relation(fields: [courseId], references: [id])
  employee PwmEmployee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([courseId, status])
  @@map("pwm_enrolments")
}

/// departmentId null = a company-wide pool.
model PwmTrainingBudget {
  id           String  @id @default(uuid())
  departmentId String?
  year         Int
  amount       Decimal @db.Decimal(14, 2)

  @@unique([departmentId, year])
  @@map("pwm_training_budgets")
}

model PwmDevelopmentPlan {
  id          String    @id @default(uuid())
  employeeId  String
  goal        String
  /// [{ title, dueDate, done }]
  actions     Json?
  reviewDate  DateTime? @db.Date
  /// ACTIVE, ACHIEVED or DROPPED
  status      String    @default("ACTIVE")
  createdById String?
  createdAt   DateTime  @default(now())

  employee PwmEmployee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@map("pwm_development_plans")
}

model PwmSkill {
  id       String  @id @default(uuid())
  name     String  @unique
  category String?

  assessments  PwmSkillAssessment[]
  requirements PwmPositionSkill[]

  @@map("pwm_skills")
}

model PwmSkillAssessment {
  id           String   @id @default(uuid())
  employeeId   String
  skillId      String
  /// 1 (basic) to 5 (expert)
  level        Int
  assessedById String?
  note         String?
  assessedAt   DateTime @default(now())

  employee PwmEmployee @relation(fields: [employeeId], references: [id])
  skill    PwmSkill    @relation(fields: [skillId], references: [id])

  @@index([employeeId, skillId, assessedAt])
  @@map("pwm_skill_assessments")
}

/// What a job title needs, so gaps can be shown against it.
model PwmPositionSkill {
  id            String @id @default(uuid())
  jobTitle      String
  skillId       String
  requiredLevel Int

  skill PwmSkill @relation(fields: [skillId], references: [id])

  @@unique([jobTitle, skillId])
  @@map("pwm_position_skills")
}

model PwmAsset {
  id             String    @id @default(uuid())
  tag            String    @unique
  /// LAPTOP, PHONE, ID_CARD, ACCESS_CARD, EQUIPMENT, VEHICLE, SOFTWARE, OTHER
  category       String
  name           String
  serial         String?
  purchaseDate   DateTime? @db.Date
  cost           Decimal?  @db.Decimal(14, 2)
  supplier       String?
  warrantyExpiry DateTime? @db.Date
  location       String?
  /// NEW, GOOD, FAIR or POOR
  condition      String    @default("GOOD")
  /// IN_STOCK, ASSIGNED, IN_REPAIR, LOST or RETIRED
  status         String    @default("IN_STOCK")
  /// Software seats; vehicles can record insurance and roadworthiness dates.
  seats          Int?
  /// [{ label, date }] dates that need a reminder
  expiries       Json?
  notes          String?
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())

  assignments PwmAssetAssignment[]
  events      PwmAssetEvent[]

  @@index([status])
  @@map("pwm_assets")
}

model PwmAssetAssignment {
  id             String    @id @default(uuid())
  assetId        String
  employeeId     String
  assignedAt     DateTime  @default(now())
  assignedById   String?
  conditionOut   String?
  acknowledgedAt DateTime?
  returnedAt     DateTime?
  conditionIn    String?
  receivedById   String?
  /// ACTIVE, RETURNED, WRITTEN_OFF or CHARGED
  status         String    @default("ACTIVE")
  resolutionNote String?
  resolvedById   String?

  asset    PwmAsset    @relation(fields: [assetId], references: [id])
  employee PwmEmployee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, status])
  @@index([assetId])
  @@map("pwm_asset_assignments")
}

model PwmAssetEvent {
  id        String   @id @default(uuid())
  assetId   String
  /// MAINTENANCE, CONDITION, LOST, DAMAGED, FOUND, NOTE
  kind      String
  note      String
  cost      Decimal? @db.Decimal(12, 2)
  /// For lost or damaged items: who bears the cost
  recovery  String?
  byUserId  String?
  createdAt DateTime @default(now())

  asset PwmAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, createdAt])
  @@map("pwm_asset_events")
}

/// Grievances and disciplinary cases. Visible only to the people named on them.
model PwmCase {
  id               String    @id @default(uuid())
  reference        String    @unique
  /// GRIEVANCE or DISCIPLINARY
  type             String
  employeeId       String
  category         String
  /// LOW, MEDIUM, HIGH
  severity         String    @default("MEDIUM")
  summary          String
  /// INTAKE, INVESTIGATION, HEARING, OUTCOME, APPEAL or CLOSED
  stage            String    @default("INTAKE")
  responseDue      DateTime? @db.Date
  hearingAt        DateTime?
  appealDue        DateTime? @db.Date
  /// NO_ACTION, VERBAL_WARNING, WRITTEN_WARNING, FINAL_WARNING, SUSPENSION, TERMINATION, UPHELD, PARTLY_UPHELD, NOT_UPHELD
  outcome          String?
  outcomeNote      String?
  warningExpiresAt DateTime? @db.Date
  raisedByUserId   String?
  closedAt         DateTime?
  createdAt        DateTime  @default(now())

  employee PwmEmployee      @relation(fields: [employeeId], references: [id])
  handlers PwmCaseHandler[]
  events   PwmCaseEvent[]

  @@index([employeeId])
  @@index([stage])
  @@map("pwm_cases")
}

model PwmCaseHandler {
  id            String    @id @default(uuid())
  caseId        String
  userId        String
  /// HANDLER, INVESTIGATOR or PANEL
  role          String    @default("HANDLER")
  recusedAt     DateTime?
  recusalReason String?
  addedById     String?
  createdAt     DateTime  @default(now())

  case PwmCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, userId])
  @@index([userId])
  @@map("pwm_case_handlers")
}

model PwmCaseEvent {
  id        String   @id @default(uuid())
  caseId    String
  /// NOTE, QUERY, RESPONSE, EVIDENCE, HEARING, OUTCOME, APPEAL, LETTER, STAGE
  kind      String
  text      String
  fileUrl   String?
  byUserId  String?
  createdAt DateTime @default(now())

  case PwmCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
  @@map("pwm_case_events")
}

model PwmRecognition {
  id         String   @id @default(uuid())
  employeeId String
  /// AWARD, COMMENDATION or MILESTONE
  kind       String
  title      String
  citation   String?
  date       DateTime @db.Date
  givenById  String?
  announced  Boolean  @default(false)
  createdAt  DateTime @default(now())

  employee PwmEmployee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@map("pwm_recognitions")
}

model PwmSurvey {
  id            String    @id @default(uuid())
  title         String
  description   String?
  anonymous     Boolean   @default(true)
  /// DRAFT, OPEN or CLOSED
  status        String    @default("DRAFT")
  /// [{ id, type: RATING|TEXT|CHOICE, text, options? }]
  questions     Json
  departmentIds Json?
  opensAt       DateTime?
  closesAt      DateTime?
  createdById   String?
  createdAt     DateTime  @default(now())

  responses     PwmSurveyResponse[]
  participation PwmSurveyParticipation[]

  @@map("pwm_surveys")
}

/// employeeId is null on anonymous surveys; participation is kept separately so nobody answers twice.
model PwmSurveyResponse {
  id           String   @id @default(uuid())
  surveyId     String
  employeeId   String?
  departmentId String?
  answers      Json
  createdAt    DateTime @default(now())

  survey PwmSurvey @relation(fields: [surveyId], references: [id])

  @@index([surveyId])
  @@map("pwm_survey_responses")
}

model PwmSurveyParticipation {
  id         String   @id @default(uuid())
  surveyId   String
  employeeId String
  createdAt  DateTime @default(now())

  survey PwmSurvey @relation(fields: [surveyId], references: [id])

  @@unique([surveyId, employeeId])
  @@map("pwm_survey_participation")
}

model PwmExpenseClaim {
  id              String    @id @default(uuid())
  reference       String    @unique
  employeeId      String
  title           String
  travelRequestId String?
  /// DRAFT, SUBMITTED, APPROVED, REJECTED or PAID
  status          String    @default("DRAFT")
  total           Decimal   @default(0) @db.Decimal(14, 2)
  approverUserId  String?
  decidedById     String?
  decidedAt       DateTime?
  decisionNote    String?
  paidById        String?
  paidAt          DateTime?
  paymentRef      String?
  submittedAt     DateTime?
  createdAt       DateTime  @default(now())

  employee PwmEmployee      @relation(fields: [employeeId], references: [id])
  items    PwmExpenseItem[]

  @@index([employeeId])
  @@index([status])
  @@map("pwm_expense_claims")
}

model PwmExpenseItem {
  id          String   @id @default(uuid())
  claimId     String
  category    String
  amount      Decimal  @db.Decimal(12, 2)
  date        DateTime @db.Date
  description String
  receiptUrl  String?
  /// Why an amount above the category limit is justified
  exception   String?

  claim PwmExpenseClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@map("pwm_expense_items")
}

model PwmTravelRequest {
  id             String    @id @default(uuid())
  employeeId     String
  purpose        String
  destination    String
  startDate      DateTime  @db.Date
  endDate        DateTime  @db.Date
  estimatedCost  Decimal   @default(0) @db.Decimal(12, 2)
  advance        Decimal   @default(0) @db.Decimal(12, 2)
  /// Calculated from the per-diem rate and the number of days
  perDiem        Decimal   @default(0) @db.Decimal(12, 2)
  /// PENDING, APPROVED, REJECTED, CANCELLED or COMPLETED
  status         String    @default("PENDING")
  approverUserId String?
  decidedById    String?
  decidedAt      DateTime?
  decisionNote   String?
  createdAt      DateTime  @default(now())

  employee PwmEmployee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([status])
  @@map("pwm_travel_requests")
}

// ── PWM Phase 5: workforce planning and succession ──────────────────────────

model PwmHeadcountPlan {
  id           String    @id @default(uuid())
  year         Int
  departmentId String
  jobTitle     String
  planned      Int
  notes        String?
  /// DRAFT, SUBMITTED, APPROVED or REJECTED
  status       String    @default("DRAFT")
  preparedById String?
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([year, departmentId, jobTitle])
  @@index([year, status])
  @@map("pwm_headcount_plans")
}

model PwmKeyPosition {
  id           String    @id @default(uuid())
  jobTitle     String
  departmentId String?
  incumbentId  String?
  /// HIGH, MEDIUM or LOW: how badly the business is hurt if the seat is empty
  criticality  String    @default("MEDIUM")
  notes        String?
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())

  successors PwmSuccessor[]

  @@index([archivedAt])
  @@map("pwm_key_positions")
}

model PwmSuccessor {
  id              String   @id @default(uuid())
  positionId      String
  employeeId      String
  /// READY_NOW, ONE_TO_TWO_YEARS or THREE_PLUS_YEARS
  readiness       String
  developmentNote String?
  addedById       String?
  createdAt       DateTime @default(now())

  position PwmKeyPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@unique([positionId, employeeId])
  @@map("pwm_successors")
}
