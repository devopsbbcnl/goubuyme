  description    String?
  dueAt          DateTime?
  priority       TaskPriority @default(NORMAL)
  status         TaskStatus   @default(OPEN)
  assigneeId     String?
  createdById    String?
  relatedUserId  String?
  leadId         String?
  ticketId       String?
  completedAt    DateTime?
  reminderSentAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  assignee       User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy      User?        @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  relatedUser    User?        @relation("TaskRelatedUser", fields: [relatedUserId], references: [id], onDelete: Cascade)
  lead           Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  ticket         Ticket?      @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([assigneeId, status, dueAt])
  @@index([status, dueAt])
  @@index([relatedUserId])
  @@index([leadId])
  @@index([ticketId])
  @@map("crm_tasks")
}

/// Once-per-period claim for scheduled jobs, so cluster workers don't each run the same daily job.
model JobLock {
  key       String   @id
  claimedAt DateTime @default(now())

  @@map("job_locks")
}

// One row per day the ops-briefing agent reported on (opsBriefing.service.ts). The unique `day`
// makes the 7am job idempotent across restarts and multiple server instances.
model OpsBriefing {
  id         String    @id @default(uuid())
  /// Lagos calendar day the briefing covers, YYYY-MM-DD.
  day        String    @unique
  metrics    Json
  flags      Json
  summary    Json?
  /// "llm" when Claude wrote the narrative, "rules" when it fell back to rule-based flags only.
  analyzedBy String
  model      String?
  html       String
  sentAt     DateTime?
  sendError  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("ops_briefings")
}

// ─── Agent framework (agentRuntime.service.ts) ───────────────────────────────────

enum AgentMode {
  /// Agent doesn't run.
  OFF
  /// Agent only proposes; a human approves every action.
  SUGGEST
  /// Actions listed in AgentConfig.autoActions run without approval; the rest are proposed.
  AUTO
}

enum AgentSuggestionStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTED
  FAILED
  /// The situation resolved itself (or the suggestion timed out) before anyone acted.
  EXPIRED
}

model AgentConfig {
  /// e.g. "dispatch_watcher"
  key         String    @id
  mode        AgentMode @default(SUGGEST)
  /// Action types allowed to run without approval when mode is AUTO.
  autoActions String[]  @default([])
  /// Agent-specific thresholds; defaults live in code and are merged over.
  settings    Json?
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("agent_configs")
}

model AgentSuggestion {
  id           String                @id @default(uuid())
  agentKey     String
  /// Action type from the agent action registry, e.g. ASSIGN_RIDER.
  action       String
  title        String
  reason       String
  payload      Json
  orderId      String?
  ticketId     String?
  status       AgentSuggestionStatus @default(PENDING)
  /// Makes each (agent, action, situation) suggested once, across ticks and server instances.
  dedupeKey    String                @unique
  /// True when it ran without human approval (AUTO mode).
  autoExecuted Boolean               @default(false)
  decidedById  String?
  decidedAt    DateTime?
  executedAt   DateTime?
  result       Json?
  error        String?
  expiresAt    DateTime
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@index([status, createdAt])
  @@index([agentKey, createdAt])
  @@index([orderId])
  @@index([ticketId])
  @@map("agent_suggestions")
}

/// A platform announcement to every active user of a role (or all). Written once
/// when staff send it and never edited or deleted — it is the record of what the
/// platform said and to how many people.
model Broadcast {
  id             String            @id @default(uuid())
  authorId       String
  audience       BroadcastAudience
  /// Set only when audience is USER: the one account the message was addressed to.
  targetUserId   String?
  title          String
  body           String
  /// Accounts that were sent the message (each gets an in-app Notification row).
  recipientCount Int
  /// Of those, how many had a push token or web subscription to be buzzed on.
  pushCount      Int
  createdAt      DateTime          @default(now())
  author         User              @relation("BroadcastAuthor", fields: [authorId], references: [id])
  targetUser     User?             @relation("BroadcastTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([targetUserId])
  @@map("broadcasts")
}

enum BroadcastAudience {
  ALL
  CUSTOMERS
  VENDORS
  RIDERS
  /// One specific account (see Broadcast.targetUserId).
  USER
}

/// A logistics company that runs a fleet of riders. The owner signs in with the
/// LOGISTICS_COMPANY role and manages the fleet from their own dashboard.
model LogisticsCompany {
  id                 String         @id @default(uuid())
  userId             String         @unique
  companyName        String         @unique
  registrationNumber String?
  address            String
  city               String
  state              String         @default("Rivers")
  latitude           Float?
  longitude          Float?
  approvalStatus     ApprovalStatus @default(PENDING)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  riders             Rider[]
  invites            FleetInvite[]

  @@index([approvalStatus])
  @@map("logistics_companies")
}

enum FleetInviteStatus {
  INVITED
  CLAIMED
  REVOKED
}

/// An email invited to join a company's fleet. Claimed automatically when a rider
/// with that (verified) email signs in.
model FleetInvite {
  id        String            @id @default(uuid())
  companyId String
  /// Lower-cased invite target.
  email     String
  status    FleetInviteStatus @default(INVITED)
  expiresAt DateTime
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  company   LogisticsCompany  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, email])
  @@index([email])
  @@map("fleet_invites")
}

// ─────────────────────────────────────────────────────────────────────────────
// SMOIS — Social Media Operations & Intelligence System (internal admin module).
// Phase 1: accounts, assignments, content + approval, calendar, publishing
// records, tasks. Metrics/analytics arrive with the platform integrations
// (Phase 2); nothing here fabricates platform data. The activity trail reuses
// AuditLog (entity "Smois*"), made append-only by a DB trigger.
// ─────────────────────────────────────────────────────────────────────────────

enum SmoisRole {
  MANAGEMENT
  MANAGER
  REVIEWER
  VIEWER
}

enum SmoisPlatform {
  FACEBOOK
  INSTAGRAM
  LINKEDIN
  X
  TIKTOK
  YOUTUBE
  WHATSAPP
  PINTEREST
  THREADS
  OTHER
}

enum SmoisConnectionStatus {
  /// Registered and tracked by hand, with no API link (the only state in Phase 1).
  MANUAL
  CONNECTED
  EXPIRED
  DISCONNECTED
  ERROR
}

enum SmoisAssignmentKind {
  PRIMARY
  SECONDARY
  TEMPORARY
}

enum SmoisContentStatus {
  IDEA
  PLANNED
  BRIEFED
  IN_PRODUCTION
  SUBMITTED
  REVISION_REQUESTED
  RESUBMITTED
  APPROVED
  REJECTED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  PUBLISH_FAILED
  ARCHIVED
  CANCELLED
}

enum SmoisReviewDecision {
  APPROVED
  REJECTED
  REVISION_REQUESTED
}

enum SmoisTaskType {
  CONTENT_CREATION
  GRAPHIC_DESIGN
  VIDEO_PRODUCTION
  PUBLISHING
  COMMUNITY_MANAGEMENT
  CAMPAIGN_EXECUTION
  AUDIENCE_ENGAGEMENT
  ANALYTICS_REVIEW
  REPORTING
  COMPETITOR_RESEARCH
  SOCIAL_LISTENING
  BRAND_MONITORING
  GENERAL
}

enum SmoisTaskStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  REVISION_REQUIRED
  APPROVED
  COMPLETED
  CANCELLED
}

enum SmoisTaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SmoisRecurrence {
  DAILY
  WEEKLY
  MONTHLY
}

/// A person with SMOIS access. Super admins have implicit full access and need no row;
/// everyone else (including operations/support admins) only gets in through a row here.
model SmoisMember {
  id                  String    @id @default(uuid())
  userId              String    @unique
  role                SmoisRole
  isActive            Boolean   @default(true)
  jobTitle            String?
  responsibilities    String?
  supervisorId        String?
  assignedToDeptAt    DateTime  @default(now())
  /// Per-person switches (defaults come from the role; super admins can change them).
  canApprove          Boolean   @default(false)
  canPublish          Boolean   @default(false)
  canEmergencyPublish Boolean   @default(false)
  canConnectAccounts  Boolean   @default(false)
  revokedAt           DateTime?
  createdById         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user        User                 @relation(fields: [userId], references: [id])
  supervisor  SmoisMember?         @relation("SmoisSupervisor", fields: [supervisorId], references: [id])
  reports     SmoisMember[]        @relation("SmoisSupervisor")
  assignments SmoisAssignment[]
  tasksOwned  SmoisTask[]          @relation("SmoisTaskAssignee")
  supporting  SmoisTaskSupporter[]

  @@index([role, isActive])
  @@map("smois_members")
}

/// A company-owned social account. One record shared by every manager, never per employee.
model SmoisAccount {
  id               String                @id @default(uuid())
  platform         SmoisPlatform
  name             String
  handle           String?
  profileImageUrl  String?
  url              String?
  category         String?
  accountType      String?
  /// Company-side owner (a department/brand or named custodian), not an employee login.
  ownerLabel       String?
  connectionStatus SmoisConnectionStatus @default(MANUAL)
  apiAuthStatus    String                @default("NOT_CONNECTED")
  connectedAt      DateTime?
  lastSyncAt       DateTime?
  description      String?
  notes            String?
  archivedAt       DateTime?
  createdById      String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  assignments SmoisAssignment[]
  variants    SmoisVariant[]
  tasks       SmoisTask[]
  snapshots   SmoisMetricSnapshot[]
  conversations SmoisConversation[]

  @@unique([platform, handle])
  @@index([platform, archivedAt])
  @@map("smois_accounts")
}

/// Who works on which account, with history. Ending an assignment keeps the row.
model SmoisAssignment {
  id           String              @id @default(uuid())
  accountId    String
  memberId     String
  kind         SmoisAssignmentKind @default(SECONDARY)
  startsAt     DateTime            @default(now())
  endsAt       DateTime?
  assignedById String?
  reason       String?
  endedReason  String?
  createdAt    DateTime            @default(now())

  account SmoisAccount @relation(fields: [accountId], references: [id])
  member  SmoisMember  @relation(fields: [memberId], references: [id])

  @@index([accountId, endsAt])
  @@index([memberId, endsAt])
  @@map("smois_assignments")
}

model SmoisCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  contents SmoisContent[]

  @@map("smois_categories")
}

/// The master brief. Platform-specific copy lives in variants, which are what get reviewed and published.
model SmoisContent {
  id          String    @id @default(uuid())
  number      Int       @unique @default(autoincrement())
  title       String
  description String?
  objective   String?
  categoryId  String?
  audience    String?
  format      String    @default("TEXT")
  keywords    String[]
  creatorId   String
  reviewerId  String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  campaignId  String?
  category SmoisCategory? @relation(fields: [categoryId], references: [id])
  campaign SmoisCampaign? @relation(fields: [campaignId], references: [id])
  variants SmoisVariant[]

  @@index([creatorId])
  @@index([archivedAt, createdAt])
  @@map("smois_contents")
}

model SmoisVariant {
  id                 String             @id @default(uuid())
  contentId          String
  accountId          String
  status             SmoisContentStatus @default(PLANNED)
  caption            String             @default("")
  hashtags           String[]
  mentions           String[]
  mediaUrls          Json               @default("[]")
  linkUrl            String?
  plannedAt          DateTime?
  scheduledAt        DateTime?
  version            Int                @default(1)
  creatorId          String
  /// Whoever last submitted it: the person who cannot also approve it.
  submittedById      String?
  submittedAt        DateTime?
  assignedReviewerId String?
  approvedById       String?
  approvedAt         DateTime?
  publishedAt        DateTime?
  publishedUrl       String?
  /// Who triggered publication and by which mechanism (MANUAL until an integration exists).
  publishedById      String?
  publishMechanism   String?
  emergencyBypass    Boolean            @default(false)
  lastReminderAt     DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  content  SmoisContent          @relation(fields: [contentId], references: [id])
  account  SmoisAccount          @relation(fields: [accountId], references: [id])
  versions SmoisVariantVersion[]
  reviews  SmoisReview[]
  comments SmoisComment[]
  attempts SmoisPublishAttempt[]
  postMetrics SmoisPostMetric[]

  @@index([accountId, status])
  @@index([status, scheduledAt])
  @@index([contentId])
  @@index([creatorId])
  @@index([publishedAt])
  @@map("smois_variants")
}

/// Immutable snapshot taken whenever copy changes, so history is never overwritten.
model SmoisVariantVersion {
  id        String    @id @default(uuid())
  variantId String
  version   Int
  caption   String
  hashtags  String[]
  mentions  String[]
  mediaUrls Json
  linkUrl   String?
  plannedAt DateTime?
  editorId  String
  reason    String?
  createdAt DateTime  @default(now())

  variant SmoisVariant @relation(fields: [variantId], references: [id])

  @@unique([variantId, version])
  @@map("smois_variant_versions")
}

model SmoisReview {
  id              String              @id @default(uuid())
  variantId       String
  reviewerId      String
  decision        SmoisReviewDecision
  comments        String?
  rejectionReason String?
  versionReviewed Int
  emergencyBypass Boolean             @default(false)
  createdAt       DateTime            @default(now())

  variant SmoisVariant @relation(fields: [variantId], references: [id])

  @@index([variantId, createdAt])
  @@index([reviewerId, createdAt])
  @@map("smois_reviews")
}

model SmoisComment {
  id        String   @id @default(uuid())
  variantId String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  variant SmoisVariant @relation(fields: [variantId], references: [id])

  @@index([variantId, createdAt])
  @@map("smois_comments")
}

/// Every publish outcome, including failures. mechanism is MANUAL until an integration executes jobs.
model SmoisPublishAttempt {
  id            String   @id @default(uuid())
  variantId     String
  success       Boolean
  mechanism     String   @default("MANUAL")
  initiatedById String
  errorCode     String?
  errorMessage  String?
  publishedUrl  String?
  retryCount    Int      @default(0)
  recovery      String?
  createdAt     DateTime @default(now())

  variant SmoisVariant @relation(fields: [variantId], references: [id])

  @@index([variantId, createdAt])
  @@map("smois_publish_attempts")
}

model SmoisTask {
  id                  String            @id @default(uuid())
  number              Int               @unique @default(autoincrement())
  title               String
  description         String?
  type                SmoisTaskType     @default(GENERAL)
  priority            SmoisTaskPriority @default(NORMAL)
  status              SmoisTaskStatus   @default(PENDING)
  assigneeId          String?
  createdById         String
  accountId           String?
  startsAt            DateTime?
  deadline            DateTime?
  expectedDeliverable String?
  completionCriteria  String?
  completedAt         DateTime?
  ruleId              String?
  /// The recurrence period this occurrence stands for (e.g. "2026-11-05"), keeping generation idempotent.
  occurrenceKey       String?
  reminderSentAt      DateTime?
  overdueNotifiedAt   DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  assignee   SmoisMember?         @relation("SmoisTaskAssignee", fields: [assigneeId], references: [id])
  account    SmoisAccount?        @relation(fields: [accountId], references: [id])
  rule       SmoisRecurringRule?  @relation(fields: [ruleId], references: [id])
  supporters SmoisTaskSupporter[]
  evidence   SmoisTaskEvidence[]
  comments   SmoisTaskComment[]
  history    SmoisTaskHistory[]

  @@unique([ruleId, occurrenceKey])
  @@index([assigneeId, status])
  @@index([status, deadline])
  @@map("smois_tasks")
}

model SmoisTaskSupporter {
  taskId   String
  memberId String

  task   SmoisTask   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  member SmoisMember @relation(fields: [memberId], references: [id])

  @@id([taskId, memberId])
  @@map("smois_task_supporters")
}

model SmoisTaskEvidence {
  id        String   @id @default(uuid())
  taskId    String
  /// POST_URL | GRAPHIC | REPORT | SCREENSHOT | VIDEO | DOCUMENT | INTERACTION | OTHER
  kind      String
  url       String?
  note      String?
  addedById String
  createdAt DateTime @default(now())

  task SmoisTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("smois_task_evidence")
}

model SmoisTaskComment {
  id        String   @id @default(uuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  task SmoisTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("smois_task_comments")
}

model SmoisTaskHistory {
  id          String           @id @default(uuid())
  taskId      String
  fromStatus  SmoisTaskStatus?
  toStatus    SmoisTaskStatus
  changedById String?
  note        String?
  createdAt   DateTime         @default(now())

  task SmoisTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("smois_task_history")
}

/// Generates one SmoisTask per period (daily/weekly/monthly) for an assignee.
model SmoisRecurringRule {
  id                  String            @id @default(uuid())
  title               String
  description         String?
  type                SmoisTaskType     @default(GENERAL)
  priority            SmoisTaskPriority @default(NORMAL)
  recurrence          SmoisRecurrence
  /// 0-6 (Sun-Sat) for WEEKLY.
  dayOfWeek           Int?
  /// 1-28 for MONTHLY.
  dayOfMonth          Int?
  /// Hours after the occurrence starts that it is due.
  dueAfterHours       Int               @default(24)
  assigneeId          String?
  accountId           String?
  expectedDeliverable String?
  isActive            Boolean           @default(true)
  createdById         String
  lastGeneratedKey    String?
  createdAt           DateTime          @default(now())

  tasks SmoisTask[]

  @@map("smois_recurring_rules")
}

/// Single-row workflow configuration (id is always "default").
model SmoisSettings {
  id                    String   @id @default("default")
  requireApproval       Boolean  @default(true)
  allowSelfApproval     Boolean  @default(false)
  minPostGapMinutes     Int      @default(30)
  approvalReminderHours Int      @default(24)
  slaHighMinutes        Int      @default(30)
  slaStandardMinutes    Int      @default(120)
  slaGeneralMinutes     Int      @default(1440)
  businessStartHour     Int      @default(8)
  businessEndHour       Int      @default(18)
  businessDays          Int[]    @default([1, 2, 3, 4, 5])
  /// AI assistance is off until a super admin switches it on.
  aiEnabled             Boolean  @default(false)
  aiDailyLimit          Int      @default(30)
  updatedById           String?
  updatedAt             DateTime @updatedAt

  @@map("smois_settings")
}

/// Per-person SMOIS switches that every user can have, including super admins (who have no SmoisMember row).
model SmoisPreference {
  userId      String   @id
  /// Email copy of SMOIS alerts. In-app alerts are always on.
  emailAlerts Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  @@map("smois_preferences")
}

// ── SMOIS phase 2: analytics, targets, performance, reports ────────────────

enum SmoisReportType {
  WEEKLY_MANAGER
  MONTHLY_DEPARTMENT
  QUARTERLY_DEPARTMENT
  ANNUAL_DEPARTMENT
}

enum SmoisReportStatus {
  DRAFT
  SUBMITTED
  CLARIFICATION_REQUESTED
  APPROVED
}

/// One account on one day. followers is a running total; the other figures cover that day.
/// dataStatus says where it came from; until integrations exist everything is MANUAL.
model SmoisMetricSnapshot {
  id               String   @id @default(uuid())
  accountId        String
  snapshotDate     DateTime @db.Date
  followers        Int?
  reach            Int?
  impressions      Int?
  engagement       Int?
  profileVisits    Int?
  videoViews       Int?
  websiteClicks    Int?
  dataStatus       String   @default("MANUAL")
  source           String   @default("Entered by hand")
  metricVersion    String   @default("v1")
  note             String?
  enteredById      String
  retrievedAt      DateTime @default(now())
  correctedById    String?
  correctedAt      DateTime?
  correctionReason String?
  createdAt        DateTime @default(now())

  account SmoisAccount @relation(fields: [accountId], references: [id])

  @@unique([accountId, snapshotDate])
  @@index([snapshotDate])
  @@map("smois_metric_snapshots")
}

/// A reading of one published post. Several can exist over time (early, day 7, final).
model SmoisPostMetric {
  id          String   @id @default(uuid())
  variantId   String
  recordedAt  DateTime @default(now())
  reach       Int?
  impressions Int?
  likes       Int?
  comments    Int?
  shares      Int?
  saves       Int?
  clicks      Int?
  videoViews  Int?
  dataStatus  String   @default("MANUAL")
  note        String?
  enteredById String

  variant SmoisVariant @relation(fields: [variantId], references: [id])

  @@index([variantId, recordedAt])
  @@map("smois_post_metrics")
}

model SmoisTarget {
  id          String        @id @default(uuid())
  name        String
  metric      String
  targetValue Float
  /// DEPARTMENT | PLATFORM | ACCOUNT | EMPLOYEE
  scope       String
  platform    SmoisPlatform?
  accountId   String?
  memberId    String?
  startsAt    DateTime
  endsAt      DateTime
  supervisorId String?
  notes       String?
  isActive    Boolean       @default(true)
  /// The last status management was told about, so a change is announced once.
  lastNotifiedStatus String?
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([scope, isActive])
  @@index([memberId])
  @@map("smois_targets")
}

/// Management's written assessment of a person for a period. Never edited or deleted, only added to.
model SmoisEvaluation {
  id          String   @id @default(uuid())
  memberId    String
  periodStart DateTime
  periodEnd   DateTime
  feedback    String
  rating      Int?
  reviewerId  String
  createdAt   DateTime @default(now())

  @@index([memberId, createdAt])
  @@map("smois_evaluations")
}

model SmoisReport {
  id           String            @id @default(uuid())
  type         SmoisReportType
  periodStart  DateTime
  periodEnd    DateTime
  authorId     String
  status       SmoisReportStatus @default(DRAFT)
  /// Figures counted from SMOIS records when the draft was generated (frozen once submitted).
  data         Json
  /// Words written by the author.
  commentary   Json              @default("{}")
  submittedAt  DateTime?
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  dueNotifiedAt DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([authorId, type, periodStart])
  @@index([type, status])
  @@map("smois_reports")
}

// ── SMOIS phase 3: inbox, contacts, campaigns, media library, listening, competitors ──

enum SmoisConversationType {
  DIRECT_MESSAGE
  COMMENT
  MENTION
  REPLY
  STORY_INTERACTION
  ENQUIRY
  REVIEW
}

enum SmoisConversationStatus {
  NEW
  OPEN
  ASSIGNED
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  ESCALATED
  RESOLVED
  CLOSED
}

enum SmoisInboxPriority {
  HIGH
  STANDARD
  GENERAL
}

enum SmoisCampaignStatus {
  PLANNING
  BRIEFING
  PREPARATION
  APPROVAL
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum SmoisSentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
  UNCERTAIN
}

model SmoisContact {
  id           String         @id @default(uuid())
  displayName  String
  username     String?
  platform     SmoisPlatform?
  profileUrl   String?
  /// Only what the person chose to share. Never scraped.
  email        String?
  phone        String?
  location     String?
  category     String         @default("OTHER")
  assignedToId String?
  tags         String[]
  notes        String?
  consentNote  String?
  consentAt    DateTime?
  anonymizedAt DateTime?
  createdById  String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  conversations SmoisConversation[]

  @@index([platform, username])
  @@index([anonymizedAt])
  @@map("smois_contacts")
}

model SmoisConversation {
  id                  String                  @id @default(uuid())
  number              Int                     @unique @default(autoincrement())
  accountId           String
  contactId           String?
  type                SmoisConversationType   @default(DIRECT_MESSAGE)
  subject             String?
  externalUrl         String?
  status              SmoisConversationStatus @default(NEW)
  priority            SmoisInboxPriority      @default(GENERAL)
  tags                String[]
  assignedMemberId    String?
  /// When it reached the platform account (not when someone logged it here).
  receivedAt          DateTime
  slaDueAt            DateTime?
  firstResponseAt     DateTime?
  firstResponderId    String?
  resolvedAt          DateTime?
  escalationType      String?
  escalatedAt         DateTime?
  escalationNote      String?
  slaBreachNotifiedAt DateTime?
  loggedById          String
  lastActivityAt      DateTime                @default(now())
  createdAt           DateTime                @default(now())

  account  SmoisAccount   @relation(fields: [accountId], references: [id])
  contact  SmoisContact?  @relation(fields: [contactId], references: [id])
  messages SmoisMessage[]

  @@index([status, priority])
  @@index([assignedMemberId, status])
  @@index([accountId, receivedAt])
  @@index([slaDueAt])
  @@map("smois_conversations")
}

model SmoisMessage {
  id             String   @id @default(uuid())
  conversationId String
  /// INBOUND (from the person), OUTBOUND (our reply, as sent on the platform) or NOTE (internal only).
  direction      String
  body           String
  authorId       String?
  occurredAt     DateTime
  createdAt      DateTime @default(now())

  conversation SmoisConversation @relation(fields: [conversationId], references: [id])

  @@index([conversationId, occurredAt])
  @@map("smois_messages")
}

model SmoisSavedReply {
  id          String   @id @default(uuid())
  title       String
  body        String
  isActive    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())

  @@map("smois_saved_replies")
}

model SmoisCampaign {
  id              String              @id @default(uuid())
  number          Int                 @unique @default(autoincrement())
  name            String
  description     String?
  objective       String?
  type            String              @default("BRAND_AWARENESS")
  ownerId         String
  status          SmoisCampaignStatus @default(PLANNING)
  startsAt        DateTime
  endsAt          DateTime
  targetAudience  String?
  budget          Float?
  expectedResults String?
  trackingLinks   Json                @default("[]")
  lessonsLearned  String?
  recommendations String?
  createdById     String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  contents SmoisContent[]
  accounts SmoisCampaignAccount[]
  members  SmoisCampaignMember[]
  results  SmoisCampaignResult[]

  @@index([status, startsAt])
  @@map("smois_campaigns")
}

model SmoisCampaignAccount {
  campaignId String
  accountId  String

  campaign SmoisCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@id([campaignId, accountId])
  @@map("smois_campaign_accounts")
}

model SmoisCampaignMember {
  campaignId String
  memberId   String

  campaign SmoisCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@id([campaignId, memberId])
  @@map("smois_campaign_members")
}

/// Results a person copied from the platform or the ads manager. Paid and organic are kept apart.
model SmoisCampaignResult {
  id          String   @id @default(uuid())
  campaignId  String
  /// PAID | ORGANIC
  channel     String
  recordedFor DateTime @db.Date
  reach       Int?
  impressions Int?
  engagement  Int?
  clicks      Int?
  leads       Int?
  conversions Int?
  spend       Float?
  revenue     Float?
  note        String?
  enteredById String
  createdAt   DateTime @default(now())

  campaign SmoisCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, channel])
  @@map("smois_campaign_results")
}

model SmoisAsset {
  id                String    @id @default(uuid())
  name              String
  description       String?
  category          String    @default("OTHER")
  fileType          String    @default("IMAGE")
  fileSize          Int?
  url               String
  folder            String?
  tags              String[]
  version           Int       @default(1)
  /// The asset this one replaces, so version history can be walked.
  previousVersionId String?
  /// DRAFT | APPROVED | REJECTED
  approvalStatus    String    @default("DRAFT")
  approvedById      String?
  usageRestrictions String?
  expiresAt         DateTime?
  expiryNotifiedAt  DateTime?
  uploadedById      String
  archivedAt        DateTime?
  createdAt         DateTime  @default(now())

  @@index([category, archivedAt])
  @@index([expiresAt])
  @@map("smois_assets")
}

model SmoisKeyword {
  id          String   @id @default(uuid())
  term        String
  /// BRAND | PRODUCT | EXECUTIVE | INDUSTRY | HASHTAG | COMPETITOR
  kind        String   @default("BRAND")
  isActive    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())

  mentions SmoisMention[]

  @@unique([term, kind])
  @@map("smois_keywords")
}

/// A public mention a person found and logged. There is no automated monitoring.
model SmoisMention {
  id              String         @id @default(uuid())
  keywordId       String?
  platform        SmoisPlatform?
  authorName      String?
  url             String?
  text            String
  sentiment       SmoisSentiment @default(UNCERTAIN)
  /// MANUAL: chosen by whoever logged it. An assistive label, never a verdict.
  sentimentSource String         @default("MANUAL")
  reach           Int?
  occurredAt      DateTime
  handled         Boolean        @default(false)
  handledById     String?
  note            String?
  loggedById      String
  createdAt       DateTime       @default(now())

  keyword SmoisKeyword? @relation(fields: [keywordId], references: [id])

  @@index([occurredAt])
  @@index([sentiment, occurredAt])
  @@map("smois_mentions")
}

model SmoisCompetitor {
  id               String        @id @default(uuid())
  name             String
  website          String?
  platform         SmoisPlatform
  handle           String?
  url              String?
  industry         String?
  notes            String?
  monitoringStatus String        @default("ACTIVE")
  createdById      String
  createdAt        DateTime      @default(now())

  snapshots SmoisCompetitorSnapshot[]

  @@unique([platform, handle])
  @@map("smois_competitors")
}

/// What a person observed on a competitor's public profile on a given day.
model SmoisCompetitorSnapshot {
  id             String   @id @default(uuid())
  competitorId   String
  observedOn     DateTime @db.Date
  followers      Int?
  postsLast7Days Int?
  avgEngagement  Float?
  popularContent String?
  campaignNote   String?
  /// PUBLIC_OBSERVATION | ESTIMATE | THIRD_PARTY
  dataKind       String   @default("PUBLIC_OBSERVATION")
  enteredById    String
  createdAt      DateTime @default(now())

  competitor SmoisCompetitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@unique([competitorId, observedOn])
  @@map("smois_competitor_snapshots")
}

/// One row per AI request: who asked, which feature, and how it went. The question and the answer are not stored.
model SmoisAiRequest {
  id              String   @id @default(uuid())
  userId          String
  feature         String
  model           String?
  /// OK | UNAVAILABLE | DISABLED | LIMIT | ERROR
  status          String
  unverifiedCount Int      @default(0)
  durationMs      Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
  @@index([feature, createdAt])
  @@map("smois_ai_requests")
}
