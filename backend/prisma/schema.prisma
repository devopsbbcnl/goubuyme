  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@map("messages")
}

/// One email verification code (sign-up, password change). The code itself is
/// never stored — only an HMAC of it. 10 min TTL, 5 attempts per code.
model EmailOtp {
  id        String   @id @default(uuid())
  userId    String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("email_otps")
}

/// One SMS verification code for a phone number. The code itself is never stored —
/// only an HMAC of it — and rows are short-lived (10 min TTL, 5 attempts).
model PhoneOtp {
  id         String    @id @default(uuid())
  userId     String
  /// Number being verified, normalised to E.164 (+234XXXXXXXXXX). Only copied
  /// onto the user once the code is confirmed.
  phone      String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("phone_otps")
}

