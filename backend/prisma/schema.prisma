generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String              @id @default(uuid())
  name                   String
  email                  String              @unique
  phone                  String?             @unique
  password               String?
  googleId               String?             @unique
  role                   Role                @default(CUSTOMER)
  avatar                 String?
  avatarPosition         String?
  isEmailVerified        Boolean             @default(false)
  isPhoneVerified        Boolean             @default(false)
  /// When `phone` was last proven by SMS OTP. Cleared whenever `phone` changes.
  phoneVerifiedAt        DateTime?
  isActive               Boolean             @default(true)
  deletedAt              DateTime?
  refreshToken           String?
  pushToken              String?
  /// Per-category switches, e.g. {"orders":false}. A missing key means on.
  notificationPrefs      Json?
  preferredLocale        String              @default("en")
  referralCode           String              @unique
  referredById           String?
  freeDeliveryCredits    Int                 @default(0)
  storeCreditBalance     Float               @default(0)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  mfaEnabled             Boolean             @default(false)
  mfaSecret              String?
  passwordResetExpiresAt DateTime?
  passwordResetToken     String?
  auditLogs              AuditLog[]
  smoisMember            SmoisMember?
  customer               Customer?
  rider                  Rider?
  referredBy             User?               @relation("Referrals", fields: [referredById], references: [id])
  referrals              User[]              @relation("Referrals")
  /// The account's main business (never a branch). Backed by Vendor.mainOwnerId, which is unique.
  vendor                 Vendor?             @relation("MainVendor")
  /// Every location the account owns: the main business plus its branches.
  vendors                Vendor[]            @relation("OwnedVendors")
  /// The branch this account is the manager of, if it is a branch-manager login.
  managedVendor          Vendor?             @relation("BranchManager")
  offerRedemptions       OfferRedemption[]
  onboardingEvents       OnboardingEvent[]
  creditTransactions     CreditTransaction[]
  phoneOtps              PhoneOtp[]
  logisticsCompany       LogisticsCompany?
  pushSubscriptions      PushSubscription[]
  broadcasts             Broadcast[]         @relation("BroadcastAuthor")
  broadcastsReceived     Broadcast[]         @relation("BroadcastTarget")
  vendorPlanChanges      VendorPlanChange[]
  crmNotesAbout          CrmNote[]           @relation("CrmNoteSubject")
  crmNotesAuthored       CrmNote[]           @relation("CrmNoteAuthor")
  crmTags                CrmUserTag[]        @relation("CrmUserTagSubject")
  crmTagsAdded           CrmUserTag[]        @relation("CrmUserTagAddedBy")
  crmActivities          CrmActivity[]       @relation("CrmActivitySubject")
  crmActivitiesActed     CrmActivity[]       @relation("CrmActivityActor")
  ticketsRequested       Ticket[]            @relation("TicketRequester")
  ticketsAssigned        Ticket[]            @relation("TicketAssignee")
  ticketMessages         TicketMessage[]
  cannedReplies          CannedReply[]
  /// Consent to promotional campaigns (NDPR). Transactional messages ignore this.
  marketingOptIn         Boolean             @default(true)
  /// Consent to product-usage analytics (AppEvent). When false, no events are stored for this user.
  analyticsOptIn         Boolean             @default(true)
  segmentsCreated        Segment[]
  campaignsCreated       Campaign[]
  campaignRecipients     CampaignRecipient[]
  automationsCreated     CrmAutomation[]
  leadsOwned             Lead[]              @relation("LeadOwner")
  leadConvertedFrom      Lead?               @relation("LeadConvertedUser")
  leadActivities         LeadActivity[]
  tasksAssigned          CrmTask[]           @relation("TaskAssignee")
  tasksCreated           CrmTask[]           @relation("TaskCreator")
  tasksAbout             CrmTask[]           @relation("TaskRelatedUser")

  @@index([role])
  @@index([createdAt])
  @@map("users")
}

model OnboardingEvent {
  id        String              @id @default(uuid())
  userId    String
  role      Role
  event     OnboardingEventType
  metadata  Json?
  createdAt DateTime            @default(now())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, event])
  @@index([role, event])
  @@index([createdAt])
  @@map("onboarding_events")
}

model Customer {
  id            String         @id @default(uuid())
  userId        String         @unique
  createdAt     DateTime       @default(now())
  addresses     Address[]
  carts         Cart[]
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  favorites     Favorite[]
  orders        Order[]
  conversations Conversation[]

  @@map("customers")
}

model Vendor {
  id                   String                      @id @default(uuid())
  /// Owning account. A branch carries its parent's owner, so one login manages every location.
  userId               String
  /// Equals userId on a main business and is null on a branch. Unique, so an account can have only
  /// one main business. Kept in sync by a database trigger (see the vendor_main_owner migration).
  mainOwnerId          String?                     @unique
  mainOwner            User?                       @relation("MainVendor", fields: [mainOwnerId], references: [id], onDelete: Cascade)
  businessName         String                      @unique
  slug                 String                      @unique
  description          String?
  logo                 String?
  logoPosition         String?
  coverImage           String?
  coverPosition        String?
  category             VendorCategory
  subcategory          String?
  address              String
  city                 String
  state                String                      @default("Rivers")
  latitude             Float?
  longitude            Float?
  isOpen               Boolean                     @default(false)
  timezone             String                      @default("Africa/Lagos")
  availabilityOverride VendorAvailabilityOverride  @default(AUTO)
  approvalStatus       ApprovalStatus              @default(PENDING)
  autoApprove          Boolean                     @default(false)
  commissionTier       CommissionTier              @default(TIER_2)
  isPharmacyFlagged    Boolean                     @default(false)
  rating               Float                       @default(0)
  totalRatings         Int                         @default(0)
  openingTime          String?
  closingTime          String?
  avgDeliveryTime      Int?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  tierChangedAt        DateTime?
  verificationBadge    VerificationBadge           @default(UNVERIFIED)
  isFeatured           Boolean                     @default(false)
  featuredUntil        DateTime?
  displayOrder         Int                         @default(0)
  favorites            Favorite[]
  menuItems            MenuItem[]
  orders               Order[]
  payoutAccount        PayoutAccount?
  businessVerification VendorBusinessVerification?
  document             VendorDocument?
  licenses             VendorLicense[]
  vendorPayouts        VendorPayout[]
  vendorPromotions     VendorPromotion[]
  businessHours        VendorBusinessHours[]
  temporaryClosures    VendorTemporaryClosure[]
  incidents            VendorIncident[]
  planChanges          VendorPlanChange[]
  /// Set on a branch: the main vendor it belongs to. Null on a main business.
  parentVendorId       String?
  parent               Vendor?                     @relation("VendorBranches", fields: [parentVendorId], references: [id], onDelete: Cascade)
  branches             Vendor[]                    @relation("VendorBranches")
  /// Branch name without the parent prefix, e.g. "Rumuola". businessName is "<parent> - <label>".
  branchLabel          String?
  /// Public contact number for this location (a branch's own line; mains use the owner's phone).
  contactPhone         String?
  /// Login for the branch manager: a separate account the owner creates and hands over, so the
  /// branch runs on its own devices with its own push notifications. Null = run by the owner.
  managerUserId        String?                     @unique
  manager              User?                       @relation("BranchManager", fields: [managerUserId], references: [id], onDelete: SetNull)
  /// With a manager in place, should the owner still receive this branch's order alerts too?
  notifyOwnerOfOrders  Boolean                     @default(true)
  user                 User                        @relation("OwnedVendors", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([parentVendorId])
  @@index([approvalStatus])
  @@index([city])
  @@index([category])
  @@index([createdAt])
  @@index([isFeatured])
  @@index([displayOrder])
  @@map("vendors")
}

/// One opening slot for a vendor on a given weekday. Multiple rows per weekday
/// represent multiple time slots (e.g. a lunch and a dinner window). Times are
/// stored as 24h "HH:MM" strings interpreted in the vendor's own timezone.
model VendorBusinessHours {
  id        String   @id @default(uuid())
  vendorId  String
  dayOfWeek Int // 0 = Sunday ... 6 = Saturday
  openTime  String // "HH:MM"
  closeTime String // "HH:MM"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  vendor    Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([vendorId, dayOfWeek])
  @@map("vendor_business_hours")
}

/// A one-off temporary closure window. endAt null means "closed until further
/// notice" (vendor must reopen manually or delete the closure).
model VendorTemporaryClosure {
  id        String    @id @default(uuid())
  vendorId  String
  startAt   DateTime  @default(now())
  endAt     DateTime?
  reason    String?
  createdAt DateTime  @default(now())
  vendor    Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([vendorId, startAt])
  @@map("vendor_temporary_closures")
}

model Rider {
  id                 String            @id @default(uuid())
  userId             String            @unique
  vehicleType        String
  plateNumber        String?
  isAvailable        Boolean           @default(false)
  isOnline           Boolean           @default(false)
  latitude           Float?
  longitude          Float?
  approvalStatus     ApprovalStatus    @default(PENDING)
  rating             Float             @default(0)
  totalRatings       Int               @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  address            String?
  city               String?
  state              String?
  earnings           Earning[]
  deliveries         Order[]
  payoutAccount      PayoutAccount?
  document           RiderDocument?
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations      Conversation[]
  /// Fleet this rider rides for, if any. While set, the rider's standing follows the company's (see services/fleet.service.ts).
  companyId          String?
  company            LogisticsCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  /// True when joining a fleet is what approved this rider; leaving the fleet then returns them to PENDING.
  approvedViaCompany Boolean           @default(false)

  @@index([approvalStatus])
  @@index([isAvailable])
  @@index([companyId])
  @@map("riders")
}

model MenuItem {
  id            String                @id @default(uuid())
  vendorId      String
  name          String
  description   String?
  price         Float
  image         String?
  imagePosition String?
  category      String?
  isAvailable   Boolean               @default(true)
  isFeatured    Boolean               @default(false)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  stockQuantity Int                   @default(0)
  cartItems     CartItem[]
  drinkOptions  MenuItemDrinkOption[]
  optionGroups  MenuItemOptionGroup[]
  vendor        Vendor                @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]

  @@index([vendorId])
  @@index([isAvailable])
  @@map("menu_items")
}

model MenuItemOptionGroup {
  id         String               @id @default(uuid())
  menuItemId String
  name       String
  required   Boolean              @default(false)
  createdAt  DateTime             @default(now())
  menuItem   MenuItem             @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  items      MenuItemOptionItem[]

  @@index([menuItemId])
  @@map("menu_item_option_groups")
}

model MenuItemOptionItem {
  id            String              @id @default(uuid())
  optionGroupId String
  name          String
  extraPrice    Float               @default(0)
  isAvailable   Boolean             @default(true)
  optionGroup   MenuItemOptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)

  @@index([optionGroupId])
  @@map("menu_item_option_items")
}

model MenuItemDrinkOption {
  id          String   @id @default(uuid())
  menuItemId  String
  name        String
  price       Float
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId])
  @@map("menu_item_drink_options")
}

model Cart {
  id         String     @id @default(uuid())
  customerId String
  vendorId   String
  updatedAt  DateTime   @updatedAt
  items      CartItem[]
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, vendorId])
  @@map("carts")
}

model CartItem {
  id         String   @id @default(uuid())
  cartId     String
  menuItemId String
  quantity   Int      @default(1)
  note       String?
  unitPrice  Float?
  // Selected drinks/option-group choices, e.g. [{ "label": "Coke", "price": 300 }, { "label": "Garri", "price": 0 }].
  // Carried through to OrderItem.selections when the order is placed.
  selections Json?
  cart       Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])

  @@map("cart_items")
}

model Address {
  id         String   @id @default(uuid())
  customerId String
  label      String
  address    String
  city       String
  state      String   @default("Rivers")
  latitude   Float?
  longitude  Float?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model Order {
  id                  String           @id @default(uuid())
  orderNumber         String           @unique
  customerId          String
  vendorId            String
  riderId             String?
  status              OrderStatus      @default(PENDING)
  subtotal            Float
  deliveryFee         Float
  originalDeliveryFee Float
  platformFee         Float
  totalAmount         Float
  freeDeliveryUsed    Boolean          @default(false)
  promoCode           String?
  promoDiscount       Float            @default(0)
  deliveryAddress     String
  deliveryLatitude    Float?
  deliveryLongitude   Float?
  distanceKm          Float?
  paymentMethod       PaymentMethod
  paymentStatus       PaymentStatus    @default(PENDING)
  paystackRef         String?
  paystackVerified    Boolean          @default(false)
  creditApplied       Float            @default(0)
  creditIssued        Float            @default(0)
  vendorNotifiedAt    DateTime?
  vendorViewedAt      DateTime?
  reminderSentAt      DateTime?
  urgentSentAt        DateTime?
  autoCancelledAt     DateTime?
  statusChangedAt     DateTime?
  riderAssignedAt     DateTime?
  note                String?
  estimatedTime       Int?
  deliveryPin         String?
  cancelReason        String?
  rating              Int?
  review              String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  stockReserved       Boolean          @default(false)
  items               OrderItem[]
  customer            Customer         @relation(fields: [customerId], references: [id])
  rider               Rider?           @relation(fields: [riderId], references: [id])
  vendor              Vendor           @relation(fields: [vendorId], references: [id])
  conversation        Conversation?
  earning             Earning?
  offerRedemption     OfferRedemption?
  vendorIncidents     VendorIncident[]
  tickets             Ticket[]
  events              OrderEvent[]

  @@index([customerId])
  @@index([vendorId])
  @@index([riderId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([status, statusChangedAt])
  @@map("orders")
}

enum OrderEventType {
  STATUS_CHANGED
  RIDER_ASSIGNED
  RIDER_UNASSIGNED
  CREDIT_ISSUED
}

enum OrderActorType {
  CUSTOMER
  VENDOR
  RIDER
  ADMIN
  SYSTEM
  AGENT
}

// Append-only timeline for an order: every status change, rider (re)assignment and goodwill
// credit, with who did it. Powers the admin timeline and stuck-order detection.
model OrderEvent {
  id         String         @id @default(uuid())
  orderId    String
  type       OrderEventType
  fromStatus OrderStatus?
  toStatus   OrderStatus?
  actorType  OrderActorType
  actorId    String?
  note       String?
  meta       Json?
  createdAt  DateTime       @default(now())
  order      Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@index([type, createdAt])
  @@map("order_events")
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  menuItemId String
  name       String
  price      Float
  quantity   Int
  // Snapshot of chosen drinks/option-group choices at order time, e.g.
  // [{ "label": "Coke", "price": 300 }, { "label": "Garri", "price": 0 }].
  selections Json?
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model Favorite {
  id         String   @id @default(uuid())
  customerId String
  vendorId   String
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  vendor     Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([customerId, vendorId])
  @@map("favorites")
}

model Earning {
  id            String       @id @default(uuid())
  riderId       String
  orderId       String       @unique
  grossAmount   Float
  platformCut   Float
  netAmount     Float
  payoutStatus  PayoutStatus @default(PENDING)
  payoutBatchId String?
  createdAt     DateTime     @default(now())
  payoutBatch   PayoutBatch? @relation(fields: [payoutBatchId], references: [id])
  rider         Rider        @relation(fields: [riderId], references: [id])
  order         Order        @relation(fields: [orderId], references: [id])

  @@index([riderId])
  @@index([payoutStatus])
  @@map("earnings")
}

model VendorPayout {
  id             String         @id @default(uuid())
  vendorId       String
  orderId        String         @unique
  subtotal       Float
  platformFee    Float
  netAmount      Float
  commissionTier CommissionTier
  payoutStatus   PayoutStatus   @default(PENDING)
  payoutBatchId  String?
  createdAt      DateTime       @default(now())
  payoutBatch    PayoutBatch?   @relation(fields: [payoutBatchId], references: [id])
  vendor         Vendor         @relation(fields: [vendorId], references: [id])

  @@index([vendorId])
  @@index([payoutStatus])
  @@map("vendor_payouts")
}

model PayoutBatch {
  id                   String         @id @default(uuid())
  batchDate            DateTime
  status               PayoutStatus   @default(PENDING)
  totalRiderPayout     Float          @default(0)
  totalVendorPayout    Float          @default(0)
  totalPlatformRevenue Float          @default(0)
  paystackBatchRef     String?
  processedAt          DateTime?
  failureReason        String?
  createdAt            DateTime       @default(now())
  riderEarnings        Earning[]
  vendorPayouts        VendorPayout[]

  @@map("payout_batches")
}

model Referral {
  id            String    @id @default(uuid())
  referrerId    String
  refereeId     String    @unique
  isActive      Boolean   @default(false)
  creditAwarded Boolean   @default(false)
  createdAt     DateTime  @default(now())
  activatedAt   DateTime?

  @@map("referrals")
}

model PayoutAccount {
  id                    String   @id @default(uuid())
  vendorId              String?  @unique
  riderId               String?  @unique
  bankName              String
  accountNumber         String
  accountName           String
  paystackRecipientCode String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  rider                 Rider?   @relation(fields: [riderId], references: [id])
  vendor                Vendor?  @relation(fields: [vendorId], references: [id])

  @@map("payout_accounts")
}

model Offer {
  id          String            @id @default(uuid())
  title       String
  description String?
  imageUrl    String?
  code        String?           @unique
  discount    Float
  isPercent   Boolean           @default(true)
  minOrder    Float             @default(0)
  vendorId    String?
  expiresAt   DateTime?
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  redemptions OfferRedemption[]

  @@map("offers")
}

model OfferRedemption {
  id        String   @id @default(uuid())
  offerId   String
  userId    String
  orderId   String   @unique
  code      String
  discount  Float
  createdAt DateTime @default(now())
  offer     Offer    @relation(fields: [offerId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([offerId, userId])
  @@index([userId])
  @@map("offer_redemptions")
}

model VendorDocument {
  id           String         @id @default(uuid())
  vendorId     String         @unique
  type         DocumentType
  number       String
  imageUrl     String
  imageUrlBack String?
  status       DocumentStatus @default(PENDING)
  reviewNote   String?
  rejectedItem String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  selfieUrl    String?
  vendor       Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("vendor_documents")
}

model VendorBusinessVerification {
  id          String         @id @default(uuid())
  vendorId    String         @unique
  cacNumber   String?
  cacImageUrl String?
  tin         String?
  status      DocumentStatus @default(PENDING)
  reviewNote  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  vendor      Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("vendor_business_verifications")
}

model VendorLicense {
  id            String        @id @default(uuid())
  vendorId      String
  type          LicenseType
  licenseNumber String
  imageUrl      String
  expiresAt     DateTime?
  status        LicenseStatus @default(PENDING)
  reviewNote    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  vendor        Vendor        @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("vendor_licenses")
}

model RiderDocument {
  id               String         @id @default(uuid())
  riderId          String         @unique
  ninNumber        String
  ninImageUrl      String?
  selfieUrl        String?
  vehicleImageUrl  String?
  guarantorName    String?
  guarantorPhone   String?
  guarantorAddress String?
  status           DocumentStatus @default(PENDING)
  reviewNote       String?
  rejectedItem     String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  rider            Rider          @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@map("rider_documents")
}

model VendorPromotion {
  id            String   @id @default(uuid())
  vendorId      String
  title         String
  imageUrl      String
  imagePosition String?
  code          String?
  isActive      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  vendor        Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@map("vendor_promotions")
}

model AuditLog {
  id        String         @id @default(uuid())
  /// Null when an agent acted on its own (actorType AGENT).
  userId    String?
  actorType OrderActorType @default(ADMIN)
  /// Which agent acted or suggested the action, e.g. "dispatch_watcher".
  agentKey  String?
  action    String
  entity    String
  entityId  String
  meta      Json?
  ip        String?
  createdAt DateTime       @default(now())
  user      User?          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([agentKey, createdAt])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

/// One commission-tier switch for a vendor. Written on every tier change,
/// whether the vendor initiated it themselves (PATCH /vendors/me/tier) or an
/// admin did (PATCH /admin/vendors/:id/tier). `actor` is the user who made the
/// change — the vendor's own user for self-switches, the admin's user otherwise.
model VendorPlanChange {
  id          String              @id @default(uuid())
  vendorId    String
  fromTier    CommissionTier
  toTier      CommissionTier
  initiatedBy PlanChangeInitiator
  actorUserId String
  createdAt   DateTime            @default(now())
  vendor      Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  actor       User                @relation(fields: [actorUserId], references: [id])

  @@index([vendorId, createdAt])
  @@map("vendor_plan_changes")
}

model CreditTransaction {
  id           String                @id @default(uuid())
  userId       String
  type         CreditTransactionType
  amount       Float
  balanceAfter Float
  reason       String
  orderId      String?
  createdAt    DateTime              @default(now())
  user         User                  @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([orderId])
  @@map("credit_transactions")
}

model VendorIncident {
  id           String   @id @default(uuid())
  vendorId     String
  orderId      String
  incidentType String
  createdAt    DateTime @default(now())
  vendor       Vendor   @relation(fields: [vendorId], references: [id])
  order        Order    @relation(fields: [orderId], references: [id])

  @@index([vendorId])
  @@index([orderId])
  @@map("vendor_incidents")
}

model PushSubscription {
