model Campaign {
  id           String              @id @default(uuid())
  name         String
  segmentId    String?
  automationId String?
  channels     CampaignChannel[]
  title        String
  body         String
  emailSubject String?
  ctaUrl       String?
  status       CampaignStatus      @default(DRAFT)
  scheduledAt  DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  audienceSize Int?
  createdById  String
  createdAt    DateTime            @default(now())
